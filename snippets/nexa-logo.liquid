{%- comment -%}
  Nexa Vector Logo Snippet
  Accepts:
  - size: number or string (default: 32)
  - class_name: string
{%- endcomment -%}
{%- assign logo_size = size | default: 32 -%}
<svg
  width="{{ logo_size }}"
  height="{{ logo_size }}"
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class="nexa-logo-svg {{ class_name }}"
  aria-label="NexaDesk Logo"
>
  <defs>
    <linearGradient id="logoGold-{{ section.id | default: 'global' }}" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDE68A" />
      <stop offset="50%" stop-color="#D4AF37" />
      <stop offset="100%" stop-color="#A16207" />
    </linearGradient>
    <linearGradient id="logoBg-{{ section.id | default: 'global' }}" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E293B" />
      <stop offset="100%" stop-color="#0B1329" />
    </linearGradient>
    <filter id="logoGlow-{{ section.id | default: 'global' }}" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2.5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Outer rounded hexagon shield / dock frame -->
  <rect
    width="100"
    height="100"
    rx="22"
    fill="url(#logoBg-{{ section.id | default: 'global' }})"
    stroke="rgba(212, 175, 55, 0.4)"
    stroke-width="2"
  />

  <!-- Precision N geometry -->
  <path d="M26 74V26L40 26V74H26Z" fill="url(#logoGold-{{ section.id | default: 'global' }})" />

  <!-- Power Diagonal with Glow -->
  <path
    d="M40 26L60 74H74L54 26H40Z"
    fill="url(#logoGold-{{ section.id | default: 'global' }})"
    filter="url(#logoGlow-{{ section.id | default: 'global' }})"
  />

  <!-- Right Pillar -->
  <path d="M60 26H74V74H60V26Z" fill="url(#logoGold-{{ section.id | default: 'global' }})" />

  <!-- Technical Data Hub Node -->
  <circle cx="50" cy="50" r="5.5" fill="#38BDF8" />
  <circle
    cx="50"
    cy="50"
    r="8.5"
    stroke="#38BDF8"
    stroke-width="1.5"
    stroke-opacity="0.7"
  />
</svg>
