{%- comment -%}
  Interactive 'Will It Fit My Device?' PDP Widget
  Reads product role and metafields to dynamically verify compatibility.
{%- endcomment -%}

<div class="compatibility-widget-card nexa-card">
  <div class="widget-header">
    <div class="widget-icon">⚡</div>
    <div class="widget-titles">
      <h4 class="widget-heading">Will It Fit My Device?</h4>
      <p class="widget-sub">Select your laptop to verify charging wattage &amp; display output.</p>
    </div>
  </div>

  <div class="widget-selector-wrap">
    <select id="pdp-device-select" class="widget-device-dropdown" onchange="verifyPdpDevice(this.value)">
      <option value="" disabled selected>Select Host Device...</option>
      <option value="P1">Apple MacBook Pro 14" / Air (65W Required)</option>
      <option value="P2">Apple MacBook Pro 16" (100W Required)</option>
      <option value="P3">Windows PC / ThinkPad / XPS (65W Required)</option>
      <option value="P4">Legacy USB-A / Hybrid Host</option>
    </select>
  </div>

  <!-- Real-time Verification Feedback Box -->
  <div id="pdp-compat-result" class="compat-result-box" style="display:none;">
    <div class="compat-status-line">
      <span class="status-symbol">&check;</span>
      <strong class="status-text">100% Guaranteed Compatible</strong>
    </div>
    <p class="compat-explanation">
      This docking station delivers adequate GaN power and supports full native display resolution for your selected hardware.
    </p>
  </div>
</div>

<script>
  function verifyPdpDevice(profileCode) {
    const resultBox = document.getElementById('pdp-compat-result');
    if (!resultBox) return;

    resultBox.style.display = 'block';
    const statusText = resultBox.querySelector('.status-text');
    const explanation = resultBox.querySelector('.compat-explanation');
    const symbol = resultBox.querySelector('.status-symbol');

    // Assume 100W for Pro docks, or read product metafields
    const dockPower = {{ product.metafields.custom.dock_charging_output.value | default: 100 }};
    const minPowerReq = (profileCode === 'P2') ? 100 : (profileCode === 'P4' ? 0 : 65);

    if (dockPower >= minPowerReq) {
      resultBox.className = 'compat-result-box status-compatible';
      symbol.textContent = '✓';
      statusText.textContent = '100% Guaranteed Compatible';
      explanation.textContent = `Full ${dockPower}W GaN smart charging confirmed. Zero risk of battery drain under full load.`;
    } else {
      resultBox.className = 'compat-result-box status-incompatible';
      symbol.textContent = '⚠';
      statusText.textContent = 'Insufficient Wattage Detected';
      explanation.textContent = `Your laptop demands ${minPowerReq}W charging, but this unit provides ${dockPower}W. Battery discharge may occur.`;
    }
  }
</script>
