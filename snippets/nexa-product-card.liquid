{%- comment -%}
  Nexa Modern Product Card Snippet
  Accepts:
  - card_product: Product object
{%- endcomment -%}
{%- if card_product and card_product != empty -%}

  {%- assign variantUrl = card_product.url -%}
  {%- assign primaryImage = card_product.featured_media -%}
  {%- assign secondaryImage = card_product.media[1] -%}
  
  {%- assign os_list = card_product.metafields.nexadesk.supported_os.value | default: card_product.metafields.custom.supported_operating_systems.value | join: ',' | downcase -%}
  {%- assign isAppleCompatible = true -%}
  {%- assign isWindowsCompatible = true -%}
  {%- if os_list != blank -%}
    {%- assign isAppleCompatible = false -%}
    {%- assign isWindowsCompatible = false -%}
    {%- if os_list contains 'mac' -%}{%- assign isAppleCompatible = true -%}{%- endif -%}
    {%- if os_list contains 'win' -%}{%- assign isWindowsCompatible = true -%}{%- endif -%}
  {%- endif -%}

  {%- assign wattage = card_product.metafields.nexadesk.charging_output_watts.value | default: card_product.metafields.custom.dock_charging_output.value | plus: 0 -%}
  {%- assign videoOutputs = card_product.metafields.nexadesk.video_outputs.value | default: card_product.metafields.custom.dock_video_outputs.value -%}
  {%- assign videoInputs = card_product.metafields.custom.monitor_video_inputs.value -%}
  {%- assign hostConnector = card_product.metafields.nexadesk.host_connector.value | default: card_product.metafields.custom.host_connector.value -%}

  {%- assign firstVariant = card_product.selected_or_first_available_variant -%}
  {%- assign hasMultipleVariants = false -%}
  {%- if card_product.variants.size > 1 -%}
    {%- assign hasMultipleVariants = true -%}
  {%- endif -%}
  
  {%- comment -%} Store policy: all products are always available and in stock {%- endcomment -%}
  {%- assign isAvailable = true -%}
  {%- assign isLowStock = false -%}
  {%- assign stockCount = 0 -%}
  {%- if isAvailable and firstVariant.inventory_management == 'shopify' -%}
    {%- if firstVariant.inventory_quantity <= 3 and firstVariant.inventory_quantity > 0 -%}
      {%- assign isLowStock = true -%}
      {%- assign stockCount = firstVariant.inventory_quantity -%}
    {%- endif -%}
  {%- endif -%}

  {%- capture filter_ports -%}
    {%- if videoOutputs.size >= 2 or card_product.title contains 'Dual' or card_product.title contains 'dual' -%}Dual Display,{%- endif -%}
    {%- assign v_out_str = videoOutputs | join: ',' -%}
    {%- if v_out_str contains 'HDMI' or videoInputs contains 'HDMI' or card_product.description contains 'HDMI' -%}HDMI,{%- endif -%}
    {%- if v_out_str contains 'DisplayPort' or v_out_str contains 'DP' or videoInputs contains 'DisplayPort' or card_product.description contains 'DisplayPort' -%}DisplayPort,{%- endif -%}
  {%- endcapture -%}

  <div class="fluid-product-card-wrap"
    data-title="{{ card_product.title | escape }}"
    data-price="{{ card_product.price }}"
    data-available="{{ isAvailable }}"
    data-wattage="{{ wattage }}"
    data-apple="{{ isAppleCompatible }}"
    data-windows="{{ isWindowsCompatible }}"
    data-ports="{{ filter_ports | strip }}"
  >
    <div class="fluid-product-card">
      <a
        href="{{ variantUrl }}"
        class="card-media-box {% if secondaryImage %}has-secondary-image{% endif %}"
        aria-label="View details for {{ card_product.title | escape }}"
      >
        <div class="card-badge-top-left">
          {%- if isAvailable == false -%}
            <span class="stock-countdown-pill out-of-stock">
              <span class="pulse-gray-dot" aria-hidden="true"></span>
              <span>Out of Stock</span>
            </span>
          {%- elsif isLowStock -%}
            <span class="stock-countdown-pill low-stock">
              <span class="pulse-orange-dot" aria-hidden="true"></span>
              <span>Only {{ stockCount }} left in UK</span>
            </span>
          {%- else -%}
            <span class="stock-countdown-pill in-stock">
              <span class="pulse-green-dot" aria-hidden="true"></span>
              <span>In Stock • UK Hub</span>
            </span>
          {%- endif -%}
        </div>

        <div class="card-badge-top-right">
          <span class="os-badge-chip" title="Compatible with Mac & Windows">
            {%- if isAppleCompatible -%}
              <svg width="12" height="12" viewBox="0 0 384 512" fill="currentColor" aria-label="Apple logo" style="display: inline-block;">
                <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.3 48.6-.7 84.4-80.1 98.6-118.9-39.7-18.9-57.8-56.1-57.7-91.7zM252.1 84.5c18.5-22.9 29.8-53.5 26.4-84.5-26.5 1.1-58.4 17.7-77.9 40.5-16.7 19.4-29.6 50.8-25.5 81.2 29.6 2.3 58.5-14.3 77-37.2z" />
              </svg>
            {%- endif -%}
            {%- if isWindowsCompatible -%}
              <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-label="Windows logo" style="display: inline-block; margin-left: 4px;">
                <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.8" />
              </svg>
            {%- endif -%}
          </span>
        </div>

        {%- if primaryImage -%}
          <div class="card-img-layer primary-img">
            <img src="{{ primaryImage | image_url: width: 600 }}" alt="{{ primaryImage.alt | escape }}" loading="lazy" width="600" height="600" />
          </div>
        {%- endif -%}

        {%- if secondaryImage -%}
          <div class="card-img-layer secondary-img" aria-hidden="true">
            <img src="{{ secondaryImage | image_url: width: 600 }}" alt="{{ secondaryImage.alt | escape }}" loading="lazy" width="600" height="600" />
          </div>
        {%- endif -%}

        <div class="card-hover-action-bar">
          <span class="card-hover-cta">
            <span>View Setup Details</span>
            <span aria-hidden="true">&rarr;</span>
          </span>
        </div>
      </a>

      <div class="card-body">
        <div class="card-spec-pills-row">
          {%- if wattage > 0 -%}
            <span class="card-spec-pill">⚡ {{ wattage }}W Fast Charge</span>
          {%- endif -%}
          
          {%- if videoOutputs.size > 0 -%}
            {%- assign title_down = card_product.title | downcase -%}
            {%- if videoOutputs.size >= 2 or title_down contains 'dual' -%}
              <span class="card-spec-pill">🖥️ 2 Screens at Once</span>
            {%- else -%}
              <span class="card-spec-pill">🖥️ {{ videoOutputs[0] }} Plug</span>
            {%- endif -%}
          {%- elsif videoInputs.size > 0 -%}
            <span class="card-spec-pill">🖥️ {{ videoInputs | join: ' & ' }} Ready</span>
          {%- elsif hostConnector != blank -%}
            <span class="card-spec-pill">🔌 {{ hostConnector }} Cable</span>
          {%- else -%}
            <span class="card-spec-pill">✨ 1-Cord Plug & Play</span>
          {%- endif -%}
        </div>

        <h4 class="card-product-title">
          <a href="{{ variantUrl }}">{{ card_product.title }}</a>
        </h4>

        <div class="card-bottom-row">
          <div class="card-price-wrap">
            <span class="price-current">
              {{ card_product.price | money }}
            </span>
          </div>
          <span class="card-shipping-tag">Free UK 24h</span>
        </div>

        <div class="card-actions-grid">
          {%- if isAvailable == false -%}
            <button disabled class="quick-cart-btn-disabled" aria-label="Product is currently sold out">
              <span class="quick-cart-btn-inner">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                </svg>
                <span>Sold Out</span>
              </span>
            </button>
          {%- elsif hasMultipleVariants -%}
            <a href="{{ variantUrl }}" class="quick-cart-btn-link" aria-label="Select options for {{ card_product.title | escape }}">
              <span class="quick-cart-btn-inner">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span>Select Options</span>
              </span>
            </a>
          {%- else -%}
            <button
              type="button"
              class="quick-cart-btn-link add-to-cart-action"
              onclick="addCardProductToCart('{{ firstVariant.id }}')"
              aria-label="Add {{ card_product.title | escape }} to cart"
            >
              <span class="quick-cart-btn-inner">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span>Add to Cart</span>
              </span>
            </button>
          {%- endif -%}

          <div class="card-secondary-actions">
            <a href="{{ variantUrl }}" class="card-action-btn secondary-btn" title="View full specs, diagram and port layout">
              <span>Details</span>
              <span aria-hidden="true">&nearr;</span>
            </a>
            <a href="/pages/setup-builder?check={{ card_product.handle | url_encode }}" class="card-action-btn helper-btn" title="Verify if this setup fits your exact laptop">
              <span>Will it fit?</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

<script>
  if (typeof window.addCardProductToCart !== 'function') {
    window.addCardProductToCart = function(variantId) {
      if (!variantId) return;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      }).then(res => {
        if (res.ok) {
          if (window.NexaCart && typeof window.NexaCart.open === 'function') {
            window.NexaCart.open();
            window.dispatchEvent(new CustomEvent('cart:updated'));
          } else {
            window.location.href = '/cart';
          }
        }
      }).catch(err => {
        console.error('Error adding to cart:', err);
        window.location.href = '/cart';
      });
    }
  }
</script>
