<div class="nexa-compare-page" data-section-id="{{ section.id }}">
  <div class="compare-hero">
    <h1 class="compare-hero-title">Compare Docking Stations</h1>
    <p class="compare-hero-subtitle">
      Select models below to compare hardware specifications side-by-side.
    </p>

    <div class="compare-actions-bar">
      <label class="toggle-diff-label">
        <input
          type="checkbox"
          id="toggle-diff-checkbox"
          onchange="toggleDifferences(this.checked)"
        />
        <span class="toggle-slider"></span>
        Highlight Differences
      </label>
    </div>
  </div>

  <div class="compare-dock-selector" id="compare-dock-selector">
    <!-- Pills will be rendered here by JS or statically -->
  </div>

  <div id="compare-empty-state" class="compare-empty-state" style="display: none;">
    <div class="empty-state-icon">⚖️</div>
    <h2 class="empty-state-title">No Docks Selected</h2>
    <p class="empty-state-desc">
      Select up to 3 docks or hubs from the pills above to view a comprehensive side-by-side
      specification comparison.
    </p>
    <button
      type="button"
      class="btn-launch-builder"
      onclick="resetCompareSelection()"
    >
      Compare All 3 Default Docks
    </button>
  </div>

  <div
    id="compare-matrix-container"
    class="compare-matrix-container"
  >
    <div class="compare-matrix-scrollable">
      <table
        class="compare-table"
        data-spec-type="dock-comparison"
        data-currency="GBP"
      >
        <thead>
          <tr class="compare-header-row" id="compare-header-row">
            <th class="th-feature-label-col">
              <div class="feature-col-header-content">
                <span class="feature-col-title">Specifications</span>
                <span class="feature-col-subtitle" id="compare-count-subtitle">
                  Comparing 3 models
                </span>
              </div>
            </th>
            <!-- Dock Header Cols will be injected via JS based on selection -->
          </tr>
        </thead>
        <tbody id="compare-table-body">
          <!-- Rows injected via JS -->
        </tbody>
      </table>
    </div>
  </div>

  <div class="compare-bottom-builder-cta">
    <span class="cta-inner-badge">✨ Complete Workstation Configurator</span>
    <h2 class="cta-heading">Want a Guaranteed Zero-Guesswork Setup?</h2>
    <p class="cta-subtext">
      Use our interactive 4-step wizard to automatically pair your laptop with compatible docks,
      certified monitors, and precision desktop accessories.
    </p>
    <a href="/pages/setup-builder" class="btn-launch-builder">
      <span>Launch Interactive Setup Builder</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</div>

<script>
  (function() {
    const FALLBACK_DOCKS = [
      {
        id: 'gid://shopify/Product/D1',
        handle: 'd1-link-65',
        title: 'D1 Link 65 Standard Dock',
        price: '99.00',
        currency: 'GBP',
        host_connector: 'USB-C',
        supported_operating_systems: ['Windows', 'macOS'],
        dock_charging_output: 65,
        dock_video_outputs: ['HDMI'],
        product_role: 'dock',
        image: 'https://cdn.shopify.com/s/files/1/0688/1755/1584/files/D1_Link_65.png?v=1',
        tag: 'Best for MacBook Air & 65W PC'
      },
      {
        id: 'gid://shopify/Product/D2',
        handle: 'd2-link-100',
        title: 'D2 Link 100 Dual-Screen Flagship Dock',
        price: '120.00',
        currency: 'GBP',
        host_connector: 'USB-C',
        supported_operating_systems: ['Windows', 'macOS'],
        dock_charging_output: 100,
        dock_video_outputs: ['HDMI', 'DisplayPort'],
        product_role: 'dock',
        image: 'https://cdn.shopify.com/s/files/1/0688/1755/1584/files/D2_Link_100.png?v=1',
        tag: 'Flagship Dual-Screen Pick'
      },
      {
        id: 'gid://shopify/Product/D3',
        handle: 'd3-pro-100',
        title: 'D3 Pro 100 High-Speed Workstation Dock',
        price: '149.00',
        currency: 'GBP',
        host_connector: 'USB-C',
        supported_operating_systems: ['Windows'],
        dock_charging_output: 100,
        dock_video_outputs: ['DisplayPort'],
        product_role: 'dock',
        image: 'https://cdn.shopify.com/s/files/1/0688/1755/1584/files/D3_Pro_100.png?v=1',
        tag: 'Windows CAD & Heavy Workstation'
      },
      {
        id: 'gid://shopify/Product/D4',
        handle: 'd4-connect-a',
        title: 'D4 Connect A Legacy Peripheral Hub',
        price: '59.00',
        currency: 'GBP',
        host_connector: 'USB-A',
        supported_operating_systems: ['Windows', 'macOS'],
        dock_charging_output: 0,
        dock_video_outputs: [],
        product_role: 'hub-only',
        image: 'https://cdn.shopify.com/s/files/1/0688/1755/1584/files/D4_Connect_A.png?v=1',
        tag: 'USB-A Data Hub Only'
      }
    ];

    let selectedIds = FALLBACK_DOCKS.slice(0, 3).map(d => d.id);
    let showDifferencesOnly = false;

    function getDockCode(dock) {
      const match = dock.title.match(/D[1-4]/i) || dock.handle.match(/d[1-4]/i);
      if (match) return match[0].toUpperCase();
      if (dock.handle.includes('65')) return 'D1';
      if (dock.handle.includes('100') && !dock.handle.includes('pro')) return 'D2';
      if (dock.handle.includes('pro')) return 'D3';
      if (dock.handle.includes('connect')) return 'D4';
      return 'DOCK';
    }

    function renderPills() {
      const container = document.getElementById('compare-dock-selector');
      container.innerHTML = '';
      FALLBACK_DOCKS.forEach(dock => {
        const isSelected = selectedIds.includes(dock.id);
        const isDisabled = !isSelected && selectedIds.length >= 3;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `dock-pill ${isSelected ? 'is-selected' : ''}`;
        btn.textContent = getDockCode(dock);
        btn.onclick = () => toggleDock(dock.id);
        if (isDisabled) btn.disabled = true;
        container.appendChild(btn);
      });
    }

    function toggleDock(id) {
      if (selectedIds.includes(id)) {
        selectedIds = selectedIds.filter(i => i !== id);
      } else {
        if (selectedIds.length >= 3) {
          selectedIds = [...selectedIds.slice(1), id];
        } else {
          selectedIds.push(id);
        }
      }
      render();
    }

    window.removeDock = function(id) {
      selectedIds = selectedIds.filter(item => item !== id);
      render();
    }

    window.resetCompareSelection = function() {
      selectedIds = FALLBACK_DOCKS.slice(0, 3).map(d => d.id);
      render();
    }

    window.toggleDifferences = function(checked) {
      showDifferencesOnly = checked;
      const container = document.getElementById('compare-matrix-container');
      if (checked) {
        container.classList.add('compare-diff-active');
      } else {
        container.classList.remove('compare-diff-active');
      }
      renderTable();
    }

    function renderTable() {
      const selectedDocks = FALLBACK_DOCKS.filter(d => selectedIds.includes(d.id));
      const headerRow = document.getElementById('compare-header-row');
      const tbody = document.getElementById('compare-table-body');
      
      // Update count
      document.getElementById('compare-count-subtitle').textContent = `Comparing ${selectedDocks.length} models`;

      // Keep only first TH (Specifications)
      while (headerRow.children.length > 1) {
        headerRow.removeChild(headerRow.lastChild);
      }

      selectedDocks.forEach(dock => {
        const dockCode = getDockCode(dock);
        const th = document.createElement('th');
        th.className = 'th-dock-col';
        th.innerHTML = `
          <div class="dock-header-card">
            <div class="dock-header-top-row">
              <span class="dock-code-tag">${dockCode} MODEL</span>
              ${selectedDocks.length > 1 ? `<button type="button" class="dock-remove-btn" onclick="removeDock('${dock.id}')" title="Remove ${dock.title}" aria-label="Remove ${dock.title}">✕</button>` : ''}
            </div>
            <div class="dock-img-box">
              <img src="${dock.image}" alt="${dock.title}" loading="lazy" />
            </div>
            <h3 class="dock-header-title">${dock.title}</h3>
            <div class="dock-header-price-row">
              <span class="dock-header-price">£${dock.price}</span>
              <span class="dock-header-tax-pill">Free UK Delivery</span>
            </div>
            <div class="dock-header-actions">
              <a href="/products/${dock.handle}" class="btn-dock-view">
                <span>View Product Details</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        `;
        headerRow.appendChild(th);
      });

      // Rows
      const specs = [
        {
          id: 'price',
          label: 'Price (GBP)',
          getValue: d => d.price,
          render: d => `
            <div>
              <span style="font-weight: 700; color: #22c55e; font-size: 1.05rem;">£${d.price}</span>
              <div style="font-size: 0.75rem; color: #94a3b8;">Inc. UK VAT</div>
            </div>
          `
        },
        {
          id: 'host_connector',
          label: 'Host Interface',
          getValue: d => d.host_connector,
          render: d => `<span>${d.host_connector === 'USB-C' ? '⚡ USB-C (Thunderbolt Compatible)' : '🔌 USB-A 3.0'}</span>`
        },
        {
          id: 'charging_output',
          label: 'Laptop Power Delivery',
          getValue: d => d.dock_charging_output,
          render: d => `
            <div>
              ${d.dock_charging_output > 0 
                ? `<span style="color: #fbbf24; font-weight: 600;">⚡ ${d.dock_charging_output}W GaN Power Delivery</span>`
                : `<span style="color: #94a3b8;">Bus-Powered (No Laptop Charge)</span>`
              }
            </div>
          `
        },
        {
          id: 'os_support',
          label: 'OS Compatibility',
          getValue: d => d.supported_operating_systems.join(','),
          render: d => {
            const osStr = d.supported_operating_systems.join(', ').toLowerCase();
            const hasMac = osStr.includes('mac');
            const hasWin = osStr.includes('win');
            return `
              <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                ${hasMac ? `<span style="background: rgba(255,255,255,0.08); padding: 0.2rem 0.55rem; border-radius: 4px; font-size: 0.8rem;"> macOS</span>` : ''}
                ${hasWin ? `<span style="background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25); color: #38bdf8; padding: 0.2rem 0.55rem; font-size: 0.8rem; border-radius: 4px;">⊞ Windows</span>` : ''}
              </div>
            `;
          }
        },
        {
          id: 'video_outputs',
          label: 'Video Outputs',
          getValue: d => d.dock_video_outputs.join(','),
          render: d => d.dock_video_outputs.length ? d.dock_video_outputs.join(' + ') : 'None'
        }
      ];

      tbody.innerHTML = '';
      specs.forEach(spec => {
        // Calculate difference
        const vals = new Set(selectedDocks.map(d => spec.getValue(d)));
        const isDiff = vals.size > 1;

        const tr = document.createElement('tr');
        tr.className = `compare-row ${isDiff ? 'is-differing' : 'is-identical'}`;
        
        let html = `<td class="td-feature-label">
          ${isDiff && showDifferencesOnly ? `<span class="diff-sparkle-marker">✨</span>` : ''}
          <span>${spec.label}</span>
        </td>`;

        selectedDocks.forEach(dock => {
          html += `<td class="td-dock-val">${spec.render(dock)}</td>`;
        });

        tr.innerHTML = html;
        tbody.appendChild(tr);
      });
    }

    function render() {
      const container = document.getElementById('compare-matrix-container');
      const emptyState = document.getElementById('compare-empty-state');
      
      renderPills();
      
      if (selectedIds.length === 0) {
        container.style.display = 'none';
        emptyState.style.display = 'flex';
      } else {
        container.style.display = 'block';
        emptyState.style.display = 'none';
        renderTable();
      }
    }

    document.addEventListener('DOMContentLoaded', render);
  })();
</script>

{% schema %}
{
  "name": "Nexa Spec Diff Toggle",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Nexa Spec Diff Toggle"
    }
  ]
}
{% endschema %}
