<div class="nexa-compare-page" data-section-id="{{ section.id }}">
  <!-- Breadcrumbs & Status Pill -->
  <div class="compare-hero-header">
    <nav class="compare-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span style="color: #64748b;">/</span>
      <a href="/pages/find-my-setup">Setup Helper</a>
      <span style="color: #64748b;">/</span>
      <span style="color: #d4af37; font-weight: 600;">Side-by-Side Dock Comparison</span>
    </nav>
    <div class="compare-badge-pill">
      <span>⚖️ HARDWARE SPECIFICATION ENGINE</span>
    </div>
    <h1 class="compare-title">Compare Docking Stations Side-by-Side</h1>
    <p class="compare-lead">
      Direct hardware specification comparison across Nexa certified docking hubs. Evaluate host connectivity, USB-C Power Delivery, multi-display support, and OS compatibility with instant diff highlighting.
    </p>
  </div>

  <!-- Interactive Controls Bar -->
  <div class="compare-controls-card">
    <div class="compare-profile-picker">
      <span class="picker-label-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        Filter by Laptop Profile:
      </span>
      <select id="compare-profile-select" class="profile-select-dropdown" onchange="filterByLaptopProfile(this.value)">
        <option value="all">⚡ All Laptop Profiles (Show All Docks)</option>
        <option value="P1">P1: Windows Lightweight (USB-C / 65W)</option>
        <option value="P2">P2: Windows Power User (Dual Screen / 100W)</option>
        <option value="P3">P3: Apple Silicon MacBook (Thunderbolt / 65W)</option>
        <option value="P4">P4: Legacy USB-A / Data Peripheral Hub</option>
      </select>
    </div>

    <!-- UI-COMP-02: Spec Diff Toggle Switch -->
    <div class="compare-diff-toggle-wrapper">
      <label class="toggle-switch-container" for="toggle-diff-checkbox">
        <input
          type="checkbox"
          id="toggle-diff-checkbox"
          class="toggle-switch-input"
          onchange="toggleDifferences(this.checked)"
        />
        <span class="toggle-slider"></span>
        <span class="toggle-switch-label">
          <span>Highlight Differences</span>
          <span class="diff-count-badge" id="diff-counter-pill">Live</span>
        </span>
      </label>
    </div>
  </div>

  <!-- Dock Quick Selector Pills Strip -->
  <div class="compare-selector-section">
    <div class="selector-section-header">
      <span>Select Up to 4 Docks to Compare:</span>
      <span class="selector-count-badge" id="selector-count-badge">3 of 4 Active</span>
    </div>
    <div class="compare-pills-row" id="compare-dock-selector">
      <!-- Injected via JavaScript -->
    </div>
  </div>

  <!-- Empty State -->
  <div id="compare-empty-state" class="compare-empty-state" style="display: none;">
    <div class="empty-state-icon">⚖️</div>
    <h2 class="empty-state-title">No Docking Stations Selected</h2>
    <p class="empty-state-desc">
      Choose at least one model from the buttons above to view side-by-side hardware specifications, port layouts, and pricing.
    </p>
    <button
      type="button"
      class="btn-dock-view"
      style="display: inline-flex; margin: 0 auto; padding: 0.75rem 1.75rem; background: #d4af37; color: #030712; font-weight: 700;"
      onclick="resetCompareSelection()"
    >
      Restore Default Comparison (D1, D2, D3)
    </button>
  </div>

  <!-- Main Comparison Matrix Container -->
  <div
    id="compare-matrix-container"
    class="compare-matrix-container"
  >
    <div class="compare-matrix-scrollable">
      <table
        class="compare-table"
        data-spec-type="dock-comparison"
        data-currency="GBP"
      >
        <thead>
          <tr class="compare-header-row" id="compare-header-row">
            <th class="th-feature-label-col">
              <div class="feature-col-header-content">
                <span class="feature-col-title">Specifications</span>
                <span class="feature-col-subtitle" id="compare-count-subtitle">
                  Comparing 3 models
                </span>
              </div>
            </th>
            <!-- Dock Header Columns dynamically populated by JS -->
          </tr>
        </thead>
        <tbody id="compare-table-body">
          <!-- Specification rows dynamically injected via JS -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- Bottom Interactive Configurator CTA -->
  <div class="compare-bottom-builder-cta">
    <span class="cta-inner-badge">✨ Guaranteed Compatibility Guarantee</span>
    <h2 style="font-size: 1.85rem; font-weight: 800; color: #ffffff; margin: 0.75rem 0 0.5rem;">
      Unsure Which Docking Station Matches Your Laptop?
    </h2>
    <p style="color: #94a3b8; max-width: 650px; margin: 0 auto 1.5rem; font-size: 1rem; line-height: 1.6;">
      Take our quick 30-second setup quiz. We'll automatically identify your laptop port capabilities, calculate required wattage, and pair the perfect dock and dual monitors.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/pages/find-my-setup" class="hero-primary-btn" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1.85rem; background: linear-gradient(135deg, #d4af37, #f59e0b); color: #030712; font-weight: 700; border-radius: 10px; text-decoration: none;">
        <span>Launch Find My Setup Quiz</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
      <a href="/collections/all" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1.85rem; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; font-weight: 600; border-radius: 10px; text-decoration: none;">
        <span>Browse All Products</span>
      </a>
    </div>
  </div>
</div>

<script>
  (function() {
    const DOCKS = [
      {
        id: 'gid://shopify/Product/D1',
        code: 'D1',
        handle: 'd1-link-65',
        title: 'D1 Link 65 Desktop Dock',
        price: '99.00',
        currency: 'GBP',
        host_connector: 'USB-C',
        host_bandwidth: '10 Gbps USB 3.2 Gen 2',
        dock_charging_output: 65,
        dock_video_outputs: ['HDMI 2.0 (4K@60Hz)'],
        max_external_displays: '1 Monitor',
        downstream_ports: '2x USB-A 3.0, 1x USB-C Data, Gigabit LAN, 3.5mm Audio',
        power_supply: 'Included 90W GaN External Brick',
        cable_type: 'Detachable 1.0m Braided USB-C Cable Included',
        supported_operating_systems: ['Windows', 'macOS'],
        profiles: ['P1', 'P3'],
        tag: 'Best for MacBook Air & 65W Ultrabooks',
        image: 'https://cdn.shopify.com/s/files/1/1019/4983/3580/files/d1-link-65-desktop-docking-station.png?v=1790711413'
      },
      {
        id: 'gid://shopify/Product/D2',
        code: 'D2',
        handle: 'd2-link-100',
        title: 'D2 Link 100 Flagship Dual Dock',
        price: '120.00',
        currency: 'GBP',
        host_connector: 'USB-C',
        host_bandwidth: '10 Gbps (MST Multi-Stream)',
        dock_charging_output: 100,
        dock_video_outputs: ['HDMI 2.0', 'DisplayPort 1.4'],
        max_external_displays: '2 Monitors (Dual Extended 4K@60Hz on Win, Mirror/Dual on Mac)',
        downstream_ports: '3x USB-A 3.0, 1x USB-C 10Gbps, Gigabit LAN, SD Card Reader',
        power_supply: 'Included 130W High-Efficiency Power Adapter',
        cable_type: 'Detachable 1.0m 100W E-Marked USB-C Cable',
        supported_operating_systems: ['Windows', 'macOS'],
        profiles: ['P2', 'P3'],
        tag: 'Flagship Dual-Screen Pick for Workstations',
        image: 'https://cdn.shopify.com/s/files/1/1019/4983/3580/files/d2-link-100-silver-docking-station.png?v=1790712112'
      },
      {
        id: 'gid://shopify/Product/D3',
        code: 'D3',
        handle: 'd3-pro-100',
        title: 'D3 Pro 100 High-Speed Workstation',
        price: '149.00',
        currency: 'GBP',
        host_connector: 'USB-C',
        host_bandwidth: 'Thunderbolt 4 / USB4 (40 Gbps)',
        dock_charging_output: 100,
        dock_video_outputs: ['Dual DisplayPort 1.4', 'HDMI 2.1'],
        max_external_displays: 'Up to 3 Extended Displays (Windows CAD / Triple Setup)',
        downstream_ports: '4x USB-A 3.2, 2x USB-C 10Gbps, 2.5Gbps Ethernet, Optical Audio',
        power_supply: 'Included 150W Heavy-Duty Adapter',
        cable_type: '0.8m Certified 40Gbps Thunderbolt Cable',
        supported_operating_systems: ['Windows'],
        profiles: ['P2'],
        tag: 'Windows CAD, Engineering & High-Power Laptops',
        image: 'https://cdn.shopify.com/s/files/1/1019/4983/3580/files/d3-pro-100-usb-c-docking-station.png?v=1790712517'
      },
      {
        id: 'gid://shopify/Product/D4',
        code: 'D4',
        handle: 'd4-connect-a',
        title: 'D4 Connect A Legacy Peripheral Hub',
        price: '59.00',
        currency: 'GBP',
        host_connector: 'USB-A',
        host_bandwidth: '5 Gbps USB 3.0',
        dock_charging_output: 0,
        dock_video_outputs: ['None (Data & Peripherals Only)'],
        max_external_displays: '0 (Connect screen directly to laptop)',
        downstream_ports: '4x USB-A 3.0, Gigabit LAN, 3.5mm Headphone Jack',
        power_supply: 'Bus-Powered (Powered by Host PC)',
        cable_type: 'Integrated Heavy-Duty USB-A Cable (15cm)',
        supported_operating_systems: ['Windows', 'macOS'],
        profiles: ['P4'],
        tag: 'Universal Legacy USB-A Data Hub',
        image: 'https://cdn.shopify.com/s/files/1/1019/4983/3580/files/d4-connect-a.png?v=1790710793'
      }
    ];

    let selectedIds = DOCKS.slice(0, 3).map(d => d.id);
    let showDifferencesOnly = false;
    let activeProfileFilter = 'all';

    function renderPills() {
      const container = document.getElementById('compare-dock-selector');
      if (!container) return;
      container.innerHTML = '';

      DOCKS.forEach(dock => {
        const isSelected = selectedIds.includes(dock.id);
        const matchesProfile = activeProfileFilter === 'all' || dock.profiles.includes(activeProfileFilter);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `dock-pill-btn ${isSelected ? 'is-active' : ''}`;
        btn.style.opacity = matchesProfile ? '1' : '0.45';

        btn.innerHTML = `
          <span class="${isSelected ? 'pill-check-indicator' : 'pill-plus-indicator'}">${isSelected ? '✓' : '+'}</span>
          <span><strong>${dock.code}</strong> &middot; ${dock.title.replace('Desktop Dock', '').replace('Flagship Dual Dock', '').replace('High-Speed Workstation', '').replace('Legacy Peripheral Hub', '').trim()}</span>
          <span style="font-size: 0.75rem; color: #d4af37;">£${dock.price}</span>
        `;

        btn.onclick = () => toggleDock(dock.id);
        container.appendChild(btn);
      });

      const badge = document.getElementById('selector-count-badge');
      if (badge) {
        badge.textContent = `${selectedIds.length} of ${DOCKS.length} Active`;
      }
    }

    function toggleDock(id) {
      if (selectedIds.includes(id)) {
        selectedIds = selectedIds.filter(i => i !== id);
      } else {
        if (selectedIds.length >= 4) {
          selectedIds = [...selectedIds.slice(1), id];
        } else {
          selectedIds.push(id);
        }
      }
      render();
    }

    window.removeDock = function(id) {
      selectedIds = selectedIds.filter(item => item !== id);
      render();
    };

    window.resetCompareSelection = function() {
      selectedIds = DOCKS.slice(0, 3).map(d => d.id);
      render();
    };

    window.filterByLaptopProfile = function(profile) {
      activeProfileFilter = profile;
      if (profile !== 'all') {
        const matchingDocks = DOCKS.filter(d => d.profiles.includes(profile));
        if (matchingDocks.length > 0) {
          selectedIds = matchingDocks.map(d => d.id);
        }
      }
      render();
    };

    window.toggleDifferences = function(checked) {
      showDifferencesOnly = checked;
      const container = document.getElementById('compare-matrix-container');
      if (container) {
        if (checked) {
          container.classList.add('compare-diff-active');
        } else {
          container.classList.remove('compare-diff-active');
        }
      }
      renderTable();
    };

    function renderTable() {
      const selectedDocks = DOCKS.filter(d => selectedIds.includes(d.id));
      const headerRow = document.getElementById('compare-header-row');
      const tbody = document.getElementById('compare-table-body');
      const counterSubtitle = document.getElementById('compare-count-subtitle');

      if (!headerRow || !tbody) return;

      if (counterSubtitle) {
        counterSubtitle.textContent = `Comparing ${selectedDocks.length} models`;
      }

      while (headerRow.children.length > 1) {
        headerRow.removeChild(headerRow.lastChild);
      }

      selectedDocks.forEach(dock => {
        const th = document.createElement('th');
        th.className = 'th-dock-col';
        th.innerHTML = `
          <div class="dock-header-card">
            <div class="dock-header-top-row">
              <span class="dock-code-tag">${dock.code} MODEL</span>
              ${selectedDocks.length > 1 ? `<button type="button" class="dock-remove-btn" onclick="removeDock('${dock.id}')" title="Remove ${dock.title}" aria-label="Remove ${dock.title}">✕</button>` : ''}
            </div>
            <div class="dock-img-box">
              <img src="${dock.image}" alt="${dock.title}" loading="lazy" />
            </div>
            <h3 class="dock-header-title">${dock.title}</h3>
            <div class="dock-header-price-row">
              <span class="dock-header-price">£${dock.price}</span>
              <span class="dock-header-tax-pill">Free UK Delivery</span>
            </div>
            <div style="font-size: 0.75rem; color: #fbbf24; font-weight: 500;">
              ${dock.tag}
            </div>
            <div class="dock-header-actions">
              <a href="/products/${dock.handle}" class="btn-dock-view">
                <span>View Product Details</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        `;
        headerRow.appendChild(th);
      });

      const specs = [
        {
          id: 'price',
          label: 'Price (GBP)',
          getValue: d => d.price,
          render: d => `
            <div>
              <span style="font-weight: 700; color: #22c55e; font-size: 1.15rem;">£${d.price}</span>
              <div style="font-size: 0.75rem; color: #94a3b8;">Inc. 20% UK VAT</div>
            </div>
          `
        },
        {
          id: 'host_connector',
          label: 'Host Laptop Port',
          getValue: d => d.host_connector,
          render: d => `
            <div>
              <strong style="color: ${d.host_connector === 'USB-C' ? '#38bdf8' : '#fbbf24'}; font-size: 1rem;">
                ${d.host_connector === 'USB-C' ? '⚡ USB-C / Thunderbolt' : '🔌 Standard USB-A 3.0'}
              </strong>
              <div style="font-size: 0.78rem; color: #94a3b8; margin-top: 0.2rem;">${d.host_bandwidth}</div>
            </div>
          `
        },
        {
          id: 'charging_output',
          label: 'Laptop Charging (PD)',
          getValue: d => d.dock_charging_output,
          render: d => `
            <div>
              ${d.dock_charging_output > 0 
                ? `<span style="display: inline-flex; align-items: center; gap: 0.3rem; background: rgba(251, 191, 36, 0.12); border: 1px solid rgba(251, 191, 36, 0.3); color: #fbbf24; padding: 0.25rem 0.65rem; border-radius: 6px; font-weight: 700; font-size: 0.95rem;">⚡ ${d.dock_charging_output}W Fast Power Delivery</span>`
                : `<span style="background: rgba(148, 163, 184, 0.1); color: #94a3b8; padding: 0.25rem 0.65rem; border-radius: 6px; font-size: 0.85rem;">Bus-Powered (No Laptop Charge)</span>`
              }
            </div>
          `
        },
        {
          id: 'os_support',
          label: 'Operating System Compatibility',
          getValue: d => d.supported_operating_systems.join(','),
          render: d => {
            const osStr = d.supported_operating_systems.join(', ').toLowerCase();
            const hasMac = osStr.includes('mac');
            const hasWin = osStr.includes('win');
            return `
              <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                ${hasMac ? `<span style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); color: #ffffff; padding: 0.25rem 0.65rem; border-radius: 6px; font-size: 0.82rem; font-weight: 600;"> macOS</span>` : ''}
                ${hasWin ? `<span style="background: rgba(56, 189, 248, 0.12); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; padding: 0.25rem 0.65rem; font-size: 0.82rem; border-radius: 6px; font-weight: 600;">⊞ Windows</span>` : ''}
                ${!hasMac ? `<span style="font-size: 0.72rem; color: #f87171; display: block; width: 100%; margin-top: 0.2rem;">Not recommended for macOS</span>` : ''}
              </div>
            `;
          }
        },
        {
          id: 'video_outputs',
          label: 'Display Video Ports',
          getValue: d => d.dock_video_outputs.join(','),
          render: d => `
            <div>
              <div style="color: #f8fafc; font-weight: 600;">${d.dock_video_outputs.join(' &bull; ')}</div>
              <div style="font-size: 0.78rem; color: #38bdf8; margin-top: 0.25rem;">🖥️ ${d.max_external_displays}</div>
            </div>
          `
        },
        {
          id: 'downstream_ports',
          label: 'Hub & Accessory Ports',
          getValue: d => d.downstream_ports,
          render: d => `<span style="font-size: 0.85rem; color: #cbd5e1; line-height: 1.5;">${d.downstream_ports}</span>`
        },
        {
          id: 'power_supply',
          label: 'Power Supply Included',
          getValue: d => d.power_supply,
          render: d => `<span style="font-size: 0.85rem; color: #94a3b8;">${d.power_supply}</span>`
        },
        {
          id: 'cable_type',
          label: 'In-The-Box Host Cable',
          getValue: d => d.cable_type,
          render: d => `<span style="font-size: 0.85rem; color: #cbd5e1;">${d.cable_type}</span>`
        }
      ];

      tbody.innerHTML = '';
      specs.forEach(spec => {
        const vals = new Set(selectedDocks.map(d => spec.getValue(d)));
        const isDiff = vals.size > 1;

        const tr = document.createElement('tr');
        tr.className = `compare-row ${isDiff ? 'is-differing' : 'is-identical'}`;

        let html = `<td class="td-feature-label">
          ${isDiff ? `<span class="diff-sparkle-marker">✨</span>` : ''}
          <span>${spec.label}</span>
        </td>`;

        selectedDocks.forEach(dock => {
          html += `<td class="td-dock-val">${spec.render(dock)}</td>`;
        });

        tr.innerHTML = html;
        tbody.appendChild(tr);
      });
    }

    function render() {
      const container = document.getElementById('compare-matrix-container');
      const emptyState = document.getElementById('compare-empty-state');

      renderPills();

      if (selectedIds.length === 0) {
        if (container) container.style.display = 'none';
        if (emptyState) emptyState.style.display = 'block';
      } else {
        if (container) container.style.display = 'block';
        if (emptyState) emptyState.style.display = 'none';
        renderTable();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', render);
    } else {
      render();
    }
  })();
</script>

{% schema %}
{
  "name": "Nexa Spec Diff Toggle",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Nexa Spec Diff Toggle"
    }
  ]
}
{% endschema %}
