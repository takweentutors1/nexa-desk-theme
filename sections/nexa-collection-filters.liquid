{%- comment -%}
  Nexa Collection Filters Section
  Replaces standard Dawn filters with exact Hydrogen replica.
{%- endcomment -%}

<div class="collection-page-layout" data-section-id="{{ section.id }}">
  <!-- Collection Hero Banner -->
  <div class="collection-hero-banner">
    <div class="collection-hero-inner">
      <div class="collection-breadcrumbs">
        <a href="/">Home</a> / <a href="/collections">Collections</a> / <span class="current">{{ collection.title | default: 'All Products' }}</span>
      </div>
      <h1 class="collection-hero-title">{{ collection.title | default: 'All Products & Workstations' }}</h1>
      <p class="collection-hero-desc">
        {{ collection.description | default: 'Explore premium single-cable docks, crystal-clear 4K displays, and ergonomic risers engineered for productive remote work.' }}
      </p>
      <div class="collection-meta-bar">
        <span class="meta-pill">UK Warehouse • Next-Day Dispatch Available</span>
        <span class="meta-pill-outline">30-Day Hassle-Free UK Returns</span>
      </div>
    </div>
  </div>

  <div class="collection-discovery-container">
    <div class="collection-toolbar-row">
      <div class="toolbar-left-group">
        <button type="button" class="desktop-filter-toggle-btn" onclick="document.querySelector('.collection-main-layout').classList.toggle('sidebar-hidden')">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="21" x2="4" y2="14"></line>
            <line x1="4" y1="10" x2="4" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12" y2="3"></line>
            <line x1="20" y1="21" x2="20" y2="16"></line>
            <line x1="20" y1="12" x2="20" y2="3"></line>
            <line x1="1" y1="14" x2="7" y2="14"></line>
            <line x1="9" y1="8" x2="15" y2="8"></line>
            <line x1="17" y1="16" x2="23" y2="16"></line>
          </svg>
          Hide Filters
        </button>
        <button type="button" class="mobile-filter-open-trigger" onclick="openFilterDrawer()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="21" x2="4" y2="14"></line>
            <line x1="4" y1="10" x2="4" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12" y2="3"></line>
            <line x1="20" y1="21" x2="20" y2="16"></line>
            <line x1="20" y1="12" x2="20" y2="3"></line>
            <line x1="1" y1="14" x2="7" y2="14"></line>
            <line x1="9" y1="8" x2="15" y2="8"></line>
            <line x1="17" y1="16" x2="23" y2="16"></line>
          </svg>
          Filters
        </button>
        <span class="toolbar-stats-text">Showing <strong>{{ collection.products_count | default: '18' }}</strong> items</span>
      </div>
      <div class="toolbar-sort-wrap">
        <span class="sort-label">Sort by:</span>
        <select class="collection-sort-select" id="collection-sort-select" onchange="handleSortChange(this.value)">
          <option value="featured">Featured Workstations</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
          <option value="title-asc">Alphabetical: A-Z</option>
        </select>
      </div>
    </div>

    <div class="collection-main-layout">
      <div class="filter-drawer-overlay" onclick="closeFilterDrawer()"></div>

      <!-- Desktop Sticky Sidebar -->
      <div class="faceted-filter-sidebar" id="nexa-desktop-sidebar">

        <div class="mobile-filter-close-btn">
          <span>Filters</span>
          <button type="button" aria-label="Close filters" onclick="closeFilterDrawer()">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        <div class="sticky-filter-wrapper">
      <div class="faceted-filter-content">
        <!-- Top Header Row -->
        <div class="filter-header-bar">
          <div class="filter-title-wrap">
            <svg class="filter-title-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" y1="21" x2="4" y2="14" />
              <line x1="4" y1="10" x2="4" y2="3" />
              <line x1="12" y1="21" x2="12" y2="12" />
              <line x1="12" y1="8" x2="12" y2="3" />
              <line x1="20" y1="21" x2="20" y2="16" />
              <line x1="20" y1="12" x2="20" y2="3" />
              <line x1="1" y1="14" x2="7" y2="14" />
              <line x1="9" y1="8" x2="15" y2="8" />
              <line x1="17" y1="16" x2="23" y2="16" />
            </svg>
            <span class="filter-main-title">Filters</span>
            <span class="filter-active-pill" id="filter-active-pill" style="display: none;">0 active</span>
          </div>
          <div class="filter-header-actions">
            <button type="button" class="filter-reset-btn" id="filter-reset-btn" style="display: none;" onclick="resetAllFilters()" aria-label="Clear all filters">Reset</button>
          </div>
        </div>

        <!-- Accordion 1: OS -->
        <div class="filter-accordion-item is-open" id="acc-os">
          <button type="button" class="filter-accordion-header header-os" onclick="toggleFilterAccordion('acc-os')">
            <div class="accordion-header-left">
              <span class="accordion-section-icon os-icon">💻</span>
              <span class="accordion-label">
                <span>What computer do you use?</span>
                <small class="accordion-sublabel">Guarantees 1-cord plug &amp; play</small>
              </span>
            </div>
            <div class="accordion-header-right">
              <span class="accordion-count-badge">3</span>
              <span class="accordion-chevron is-rotated" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </span>
            </div>
          </button>
          <div class="filter-accordion-body">
            <div class="os-badge-grid">
              <button type="button" class="os-pill-btn" onclick="toggleFilterParam('os', 'macOS', this)">
                <svg width="16" height="16" viewBox="0 0 384 512" fill="currentColor" style="margin-bottom: 6px;"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.3 48.6-.7 84.4-80.1 98.6-118.9-39.7-18.9-57.8-56.1-57.7-91.7zM252.1 84.5c18.5-22.9 29.8-53.5 26.4-84.5-26.5 1.1-58.4 17.7-77.9 40.5-16.7 19.4-29.6 50.8-25.5 81.2 29.6 2.3 58.5-14.3 77-37.2z" /></svg>
                <span>Apple Mac</span>
              </button>
              <button type="button" class="os-pill-btn" onclick="toggleFilterParam('os', 'Windows', this)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" style="margin-bottom: 6px;"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.8" /></svg>
                <span>Windows PC</span>
              </button>
              <button type="button" class="os-pill-btn" onclick="toggleFilterParam('os', 'Linux', this)">
                <span style="font-size: 16px; margin-bottom: 4px; display: block;">🐧</span>
                <span>Chrome/Linux</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Accordion 2: Wattage -->
        <div class="filter-accordion-item is-open" id="acc-watts">
          <button type="button" class="filter-accordion-header header-wattage" onclick="toggleFilterAccordion('acc-watts')">
            <div class="accordion-header-left">
              <span class="accordion-section-icon wattage-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" fill="currentColor" />
                </svg>
              </span>
              <span class="accordion-label">
                <span>Laptop Fast Charging</span>
                <small class="accordion-sublabel">Leave your brick in your bag</small>
              </span>
            </div>
            <div class="accordion-header-right">
              <span class="accordion-chevron is-rotated" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </span>
            </div>
          </button>
          <div class="filter-accordion-body">
            <div class="wattage-control-group">
              <div class="wattage-slider-wrap">
                <div class="wattage-val-display">
                  <span class="wattage-current-badge" id="wattage-val">0W</span>
                  <button type="button" class="wattage-clear-btn" onclick="resetWattage()">Reset</button>
                </div>
                <input type="range" min="0" max="140" step="5" class="wattage-range-slider" id="wattage-slider" oninput="document.getElementById('wattage-val').textContent=this.value+'W'; updateFilterParam('minWattage', this.value)" value="0">
                <div class="wattage-ticks-row">
                  <span>0W</span>
                  <span>140W</span>
                </div>
              </div>
              <div class="wattage-presets-row">
                <button type="button" class="wattage-preset-btn" onclick="setWattage(65, this)">
                  <span class="preset-label">65W</span>
                  <span class="preset-desc">Thin &amp; Light</span>
                </button>
                <button type="button" class="wattage-preset-btn" onclick="setWattage(100, this)">
                  <span class="preset-label">100W</span>
                  <span class="preset-desc">Pro Laptops</span>
                </button>
                <button type="button" class="wattage-preset-btn" onclick="setWattage(140, this)">
                  <span class="preset-label">140W</span>
                  <span class="preset-desc">Workstations</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Accordion 3: Ports -->
        <div class="filter-accordion-item is-open" id="acc-ports">
          <button type="button" class="filter-accordion-header header-ports" onclick="toggleFilterAccordion('acc-ports')">
            <div class="accordion-header-left">
              <span class="accordion-section-icon ports-icon">🎬</span>
              <span class="accordion-label">
                <span>Screens &amp; Cord Connections</span>
                <small class="accordion-sublabel">Pick what you want to plug in</small>
              </span>
            </div>
            <div class="accordion-header-right">
              <span class="accordion-count-badge">4</span>
              <span class="accordion-chevron is-rotated" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </span>
            </div>
          </button>
          <div class="filter-accordion-body">
            <div class="ports-toggle-list">
              <label class="port-toggle-row">
                <input type="checkbox" class="port-checkbox sr-only" onchange="toggleFilterParam('ports', 'Dual Display', this.parentElement)">
                <div class="port-custom-box" aria-hidden="true"><span>✓</span></div>
                <div class="port-info">
                  <span class="port-title">2 Big Screens at Once</span>
                  <span class="port-desc">Run dual monitors from one single wire</span>
                </div>
                <span class="port-spec-tag">Dual Monitor</span>
              </label>
              <label class="port-toggle-row">
                <input type="checkbox" class="port-checkbox sr-only" onchange="toggleFilterParam('ports', 'HDMI', this.parentElement)">
                <div class="port-custom-box" aria-hidden="true"><span>✓</span></div>
                <div class="port-info">
                  <span class="port-title">Standard TV &amp; Screen Plug (HDMI)</span>
                  <span class="port-desc">Fits virtually every monitor or TV in the UK</span>
                </div>
                <span class="port-spec-tag">Universal</span>
              </label>
              <label class="port-toggle-row">
                <input type="checkbox" class="port-checkbox sr-only" onchange="toggleFilterParam('ports', 'DisplayPort', this.parentElement)">
                <div class="port-custom-box" aria-hidden="true"><span>✓</span></div>
                <div class="port-info">
                  <span class="port-title">Pro Monitor Plug (DisplayPort)</span>
                  <span class="port-desc">For ultra-smooth high refresh desk screens</span>
                </div>
                <span class="port-spec-tag">Pro Video</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Accordion 4: Stock -->
        <div class="filter-accordion-item is-open" id="acc-stock">
          <button type="button" class="filter-accordion-header header-availability" onclick="toggleFilterAccordion('acc-stock')">
            <div class="accordion-header-left">
              <span class="accordion-section-icon availability-icon">📦</span>
              <span class="accordion-label">
                <span>Availability</span>
                <small class="accordion-sublabel">Direct UK Dispatch</small>
              </span>
            </div>
            <div class="accordion-header-right">
              <span class="accordion-count-badge">1</span>
              <span class="accordion-chevron is-rotated" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </span>
            </div>
          </button>
          <div class="filter-accordion-body">
            <div class="availability-options">
              <label class="port-toggle-row">
                <input type="checkbox" class="port-checkbox sr-only" onchange="toggleFilterParam('inStock', 'true', this.parentElement)">
                <div class="port-custom-box" aria-hidden="true"><span>✓</span></div>
                <div class="port-info">
                  <span class="port-title">In Stock for Rapid Delivery</span>
                  <span class="port-desc">Leaves UK warehouse within 24 hours</span>
                </div>
                <span class="in-stock-dot" aria-hidden="true"></span>
              </label>
            </div>
          </div>
        </div>

        <div class="filter-sidebar-footer">
          <span class="filter-footer-count">
            Showing <strong>{{ collection.products_count }}</strong> matching setups
          </span>
        </div>
      </div>
    </div>

      </div> <!-- End faceted-filter-sidebar -->
      <!-- Main Grid -->
      <div class="collection-products-area">
        <div class="products-grid">
          {% paginate collection.products by 48 %}
            {%- for product in collection.products -%}
              {% render 'nexa-product-card', card_product: product %}
            {%- else -%}
              <p class="no-products-msg" style="grid-column: 1/-1; padding: 40px; text-align: center;">No products match the selected filters.</p>
            {%- endfor -%}
          {% endpaginate %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Filter state
  var activeFilters = {
    os: [],
    minWattage: 0,
    ports: [],
    inStock: false
  };

  var activeSort = 'featured';

  function openFilterDrawer() {
    var sidebar = document.querySelector(".faceted-filter-sidebar");
    var overlay = document.querySelector(".filter-drawer-overlay");
    if (sidebar) sidebar.classList.add("mobile-drawer-open");
    if (overlay) overlay.classList.add("is-active");
    document.body.style.overflow = "hidden";
  }

  function closeFilterDrawer() {
    var sidebar = document.querySelector(".faceted-filter-sidebar");
    var overlay = document.querySelector(".filter-drawer-overlay");
    if (sidebar) sidebar.classList.remove("mobile-drawer-open");
    if (overlay) overlay.classList.remove("is-active");
    document.body.style.overflow = "";
  }

  function toggleFilterAccordion(id) {
    const el = document.getElementById(id);
    if (!el) return;
    const chevron = el.querySelector('.accordion-chevron');
    if (el.classList.contains('is-open')) {
      el.classList.remove('is-open');
      if (chevron) chevron.classList.remove('is-rotated');
      const body = el.querySelector('.filter-accordion-body');
      if (body) body.style.display = 'none';
    } else {
      el.classList.add('is-open');
      if (chevron) chevron.classList.add('is-rotated');
      const body = el.querySelector('.filter-accordion-body');
      if (body) body.style.display = 'block';
    }
  }

  function toggleFilterParam(key, value, btnOrLabelElement) {
    if (btnOrLabelElement) {
      btnOrLabelElement.classList.toggle('is-selected');
    }

    if (key === 'os') {
      const idx = activeFilters.os.indexOf(value);
      if (idx > -1) {
        activeFilters.os.splice(idx, 1);
      } else {
        activeFilters.os.push(value);
      }
    } else if (key === 'ports') {
      const idx = activeFilters.ports.indexOf(value);
      if (idx > -1) {
        activeFilters.ports.splice(idx, 1);
      } else {
        activeFilters.ports.push(value);
      }
    } else if (key === 'inStock') {
      activeFilters.inStock = !activeFilters.inStock;
    }

    updateActiveCount();
    applyFiltersAndSort();
  }

  function updateFilterParam(key, value) {
    if (key === 'minWattage') {
      activeFilters.minWattage = parseInt(value, 10) || 0;
    }
    updateActiveCount();
    applyFiltersAndSort();
  }

  function setWattage(val, btn) {
    const slider = document.getElementById('wattage-slider');
    if (slider) slider.value = val;
    const valDisplay = document.getElementById('wattage-val');
    if (valDisplay) valDisplay.textContent = val + 'W';

    document.querySelectorAll('.wattage-preset-btn').forEach(b => b.classList.remove('is-active'));
    if (btn) btn.classList.add('is-active');

    activeFilters.minWattage = parseInt(val, 10) || 0;
    updateActiveCount();
    applyFiltersAndSort();
  }

  function resetWattage() {
    const slider = document.getElementById('wattage-slider');
    if (slider) slider.value = 0;
    const valDisplay = document.getElementById('wattage-val');
    if (valDisplay) valDisplay.textContent = '0W';
    document.querySelectorAll('.wattage-preset-btn').forEach(b => b.classList.remove('is-active'));
    activeFilters.minWattage = 0;
    updateActiveCount();
    applyFiltersAndSort();
  }

  function resetAllFilters() {
    activeFilters = {
      os: [],
      minWattage: 0,
      ports: [],
      inStock: false
    };

    document.querySelectorAll('.os-pill-btn').forEach(b => b.classList.remove('is-selected'));
    document.querySelectorAll('.port-toggle-row').forEach(row => {
      row.classList.remove('is-selected');
      const chk = row.querySelector('.port-checkbox');
      if (chk) chk.checked = false;
    });

    const slider = document.getElementById('wattage-slider');
    if (slider) slider.value = 0;
    const valDisplay = document.getElementById('wattage-val');
    if (valDisplay) valDisplay.textContent = '0W';
    document.querySelectorAll('.wattage-preset-btn').forEach(b => b.classList.remove('is-active'));

    const sortSelect = document.getElementById('collection-sort-select');
    if (sortSelect) sortSelect.value = 'featured';
    activeSort = 'featured';

    updateActiveCount();
    applyFiltersAndSort();
  }

  function updateActiveCount() {
    let count = 0;
    count += activeFilters.os.length;
    count += activeFilters.ports.length;
    if (activeFilters.minWattage > 0) count += 1;
    if (activeFilters.inStock) count += 1;

    const pill = document.getElementById('filter-active-pill');
    const reset = document.getElementById('filter-reset-btn');
    if (pill) {
      if (count > 0) {
        pill.style.display = 'inline-block';
        pill.textContent = count + ' active';
      } else {
        pill.style.display = 'none';
      }
    }
    if (reset) {
      reset.style.display = count > 0 ? 'inline-block' : 'none';
    }
  }

  function handleSortChange(sortVal) {
    activeSort = sortVal;
    applyFiltersAndSort();
  }

  function applyFiltersAndSort() {
    const grid = document.querySelector('.products-grid');
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll('.fluid-product-card-wrap'));
    if (!cards.length) return;

    let visibleCount = 0;

    cards.forEach(card => {
      let isVisible = true;

      // 1. OS check
      if (activeFilters.os.length > 0) {
        const isApple = card.getAttribute('data-apple') === 'true';
        const isWindows = card.getAttribute('data-windows') === 'true';

        let matchesOs = false;
        if (activeFilters.os.includes('macOS') && isApple) matchesOs = true;
        if (activeFilters.os.includes('Windows') && isWindows) matchesOs = true;
        if (activeFilters.os.includes('Linux') && (isApple || isWindows)) matchesOs = true;

        if (!matchesOs) isVisible = false;
      }

      // 2. Wattage check
      if (isVisible && activeFilters.minWattage > 0) {
        const wattage = parseInt(card.getAttribute('data-wattage') || '0', 10);
        if (wattage < activeFilters.minWattage) {
          isVisible = false;
        }
      }

      // 3. Ports check
      if (isVisible && activeFilters.ports.length > 0) {
        const portsStr = (card.getAttribute('data-ports') || '').toLowerCase();
        for (let p of activeFilters.ports) {
          if (!portsStr.includes(p.toLowerCase())) {
            isVisible = false;
            break;
          }
        }
      }

      // 4. In Stock check
      if (isVisible && activeFilters.inStock) {
        const isAvail = card.getAttribute('data-available') === 'true';
        if (!isAvail) isVisible = false;
      }

      if (isVisible) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Sort visible cards
    cards.sort((a, b) => {
      if (activeSort === 'price-asc') {
        const pA = parseFloat(a.getAttribute('data-price') || '0');
        const pB = parseFloat(b.getAttribute('data-price') || '0');
        return pA - pB;
      } else if (activeSort === 'price-desc') {
        const pA = parseFloat(a.getAttribute('data-price') || '0');
        const pB = parseFloat(b.getAttribute('data-price') || '0');
        return pB - pA;
      } else if (activeSort === 'title-asc') {
        const tA = (a.getAttribute('data-title') || '').toLowerCase();
        const tB = (b.getAttribute('data-title') || '').toLowerCase();
        return tA.localeCompare(tB);
      }
      return 0; // featured (original order)
    });

    cards.forEach(card => grid.appendChild(card));

    // Update count labels in toolbar and sidebar footer
    const toolbarStats = document.querySelector('.toolbar-stats-text strong');
    if (toolbarStats) toolbarStats.textContent = visibleCount;

    const footerCount = document.querySelector('.filter-footer-count strong');
    if (footerCount) footerCount.textContent = visibleCount;

    // Handle empty state message
    let emptyMsg = grid.querySelector('.no-products-msg');
    if (visibleCount === 0) {
      if (!emptyMsg) {
        emptyMsg = document.createElement('p');
        emptyMsg.className = 'no-products-msg';
        emptyMsg.style.cssText = 'grid-column: 1/-1; padding: 40px; text-align: center; color: #94a3b8; font-size: 1.1rem;';
        emptyMsg.textContent = 'No products match the selected filters.';
        grid.appendChild(emptyMsg);
      }
      emptyMsg.style.display = 'block';
    } else if (emptyMsg) {
      emptyMsg.style.display = 'none';
    }
  }
</script>

