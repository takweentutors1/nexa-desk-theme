{%- comment -%}
  Mirrors hydrogen-storefront/app/components/Header.jsx
  Class names match app.css (header-wrapper, header-container, header-brand, nav-item-dropdown-wrapper, dropdown-flyout-menu, header-ctas, ...)
{%- endcomment -%}

<header class="header-wrapper" id="nexa-header" data-section-id="{{ section.id }}">
  <div class="header-container">
    <!-- Brand / Logo -->
    <a href="{{ routes.root_url }}" class="header-brand" aria-label="NexaDesk Home">
      {% render 'nexa-logo', size: 32, class_name: 'header-logo-icon' %}
      <span class="brand-name">{{ shop.name | default: 'NexaDesk' }}</span>
    </a>

    <!-- Desktop Navigation with Dropdowns -->
    <nav class="header-menu-desktop" role="navigation">
      <!-- Shop Desk Gear -->
      <div class="nav-item-dropdown-wrapper">
        <a href="{{ routes.all_products_collection_url }}" class="header-menu-item has-dropdown">
          Shop Desk Gear
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="dropdown-flyout-menu">
          <div class="dropdown-flyout-inner">
            <a href="{{ routes.all_products_collection_url }}" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">All Desk Gear</span></div>
              <p class="dropdown-sub-desc">Browse everything to build your ideal, tidy desk</p>
            </a>
            <a href="/collections/docks-hubs" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">One-Cable Docks &amp; Hubs</span><span class="dropdown-sub-badge">Popular</span></div>
              <p class="dropdown-sub-desc">Connect screens, power, and accessories with just one cable</p>
            </a>
            <a href="/collections/monitors" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">Computer Screens</span></div>
              <p class="dropdown-sub-desc">Crisp, wide screens that are gentle on your eyes</p>
            </a>
            <a href="/collections/stands" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">Adjustable Laptop Stands</span></div>
              <p class="dropdown-sub-desc">Raise your screen to eye level to stop neck and back strain</p>
            </a>
            <a href="/collections/keyboards" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">Comfortable Keyboards</span></div>
              <p class="dropdown-sub-desc">Smooth, quiet typing for Mac, Windows, and laptops</p>
            </a>
            <a href="/collections/mice" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">Wireless Mice</span></div>
              <p class="dropdown-sub-desc">Comfortable grips designed for all-day working without wrist fatigue</p>
            </a>
          </div>
        </div>
      </div>

      <!-- Setup Helper -->
      <div class="nav-item-dropdown-wrapper">
        <a href="/pages/find-my-setup" class="header-menu-item has-dropdown">
          Setup Helper
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="dropdown-flyout-menu">
          <div class="dropdown-flyout-inner">
            <a href="/pages/find-my-setup" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">Desk Setup Finder</span><span class="dropdown-sub-badge">Easy Quiz</span></div>
              <p class="dropdown-sub-desc">Tell us what laptop you have, and we show you what works perfectly</p>
            </a>
            <a href="/pages/compare-docks" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">Compare Docks Side-by-Side</span><span class="dropdown-sub-badge">Compare</span></div>
              <p class="dropdown-sub-desc">Easily see which dock has the plugs, speed, and power you need</p>
            </a>
          </div>
        </div>
      </div>

      <!-- Help & Delivery -->
      <div class="nav-item-dropdown-wrapper">
        <a href="/pages/compatibility-faq" class="header-menu-item has-dropdown">
          Help &amp; Delivery
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="dropdown-flyout-menu">
          <div class="dropdown-flyout-inner">
            <a href="/pages/compatibility-faq" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">Will It Work With My Laptop? (FAQ)</span></div>
              <p class="dropdown-sub-desc">Simple answers about plugs, chargers, and extra screens</p>
            </a>
            <a href="/pages/about" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">Who We Are</span></div>
              <p class="dropdown-sub-desc">Our UK team and our mission to simplify your workspace</p>
            </a>
            <a href="{{ routes.root_url }}policies/shipping-policy" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">UK Shipping &amp; Free Delivery</span></div>
              <p class="dropdown-sub-desc">Free next-day delivery on orders over £300, or £7.95 standard</p>
            </a>
            <a href="{{ routes.root_url }}policies/refund-policy" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">30-Day Money-Back Guarantee</span></div>
              <p class="dropdown-sub-desc">Try it on your desk risk-free with free, hassle-free returns</p>
            </a>
            <a href="{{ routes.root_url }}policies/privacy-policy" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">Privacy Policy</span></div>
              <p class="dropdown-sub-desc">How we keep your personal details private and secure</p>
            </a>
            <a href="{{ routes.root_url }}policies/terms-of-service" class="dropdown-sub-card">
              <div class="dropdown-sub-header"><span class="dropdown-sub-title">Terms of Service</span></div>
              <p class="dropdown-sub-desc">Our simple, honest shopping guidelines and store terms</p>
            </a>
          </div>
        </div>
      </div>

      <!-- Desk Tips & Guides -->
      <div class="nav-item-dropdown-wrapper">
        <a href="/blogs/journal" class="header-menu-item">Desk Tips &amp; Guides</a>
      </div>
    </nav>

    <!-- Action CTAs -->
    <div class="header-right-group">
      <nav class="header-ctas" role="navigation">
        <button class="header-menu-mobile-toggle reset" type="button" onclick="nexaToggleMobileMenu(true)" aria-label="Open mobile menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <a href="{{ routes.account_url }}" class="header-action-btn account-btn" aria-label="Account">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span class="cta-text">{% if customer %}Account{% else %}Sign in{% endif %}</span>
        </a>

        <a href="{{ routes.search_url }}" class="header-action-btn reset search-btn" aria-label="Search store">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="cta-text">Search</span>
        </a>

        <a
          href="{{ routes.cart_url }}"
          class="header-action-btn cart-badge-btn"
          id="cart-icon-bubble"
          onclick="var d=document.querySelector('cart-drawer'); if(d && typeof d.open==='function'){ event.preventDefault(); d.open(); }"
          aria-label="Cart with {{ cart.item_count }} items"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="cart-counter" id="cart-count-badge">{{ cart.item_count }}</span>
        </a>
      </nav>
    </div>
  </div>
</header>

<!-- Mobile Menu Aside -->
<div class="aside" id="nexa-mobile-aside" aria-hidden="true">
  <div class="aside-backdrop" onclick="nexaToggleMobileMenu(false)" style="position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:998;"></div>
  <aside style="position:fixed;top:0;right:0;bottom:0;width:min(400px,92vw);background:#030712;z-index:999;overflow-y:auto;padding:1.25rem;border-left:1px solid rgba(255,255,255,0.08);">
    <header style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
      <h3 style="margin:0;color:#f8fafc;">Menu</h3>
      <button class="close reset" type="button" onclick="nexaToggleMobileMenu(false)" aria-label="Close" style="color:#f8fafc;font-size:1.5rem;">&times;</button>
    </header>

    <nav class="header-menu-mobile" role="navigation">
      <!-- Quick Device Profile Selector Card -->
      <div class="mobile-profile-picker-card">
        <div class="mobile-profile-picker-header">
          <span class="picker-badge">Setup Matcher</span>
          <span class="picker-title">Select Your Laptop Profile:</span>
        </div>
        <div class="mobile-profile-grid">
          <a href="/pages/find-my-setup?profile=P1" class="mobile-profile-chip"><span class="chip-name">Studio 65</span><span class="chip-spec">Windows · 65W</span></a>
          <a href="/pages/find-my-setup?profile=P2" class="mobile-profile-chip"><span class="chip-name">Studio 100</span><span class="chip-spec">Windows · 100W</span></a>
          <a href="/pages/find-my-setup?profile=P3" class="mobile-profile-chip"><span class="chip-name">Creator 65</span><span class="chip-spec">macOS · 65W</span></a>
          <a href="/pages/find-my-setup?profile=P4" class="mobile-profile-chip"><span class="chip-name">Classic A</span><span class="chip-spec">Windows · 0W</span></a>
        </div>
      </div>

      <a href="{{ routes.root_url }}" class="header-menu-item" style="--item-index: 0;">Home</a>

      <div class="mobile-menu-group" style="--item-index: 1;">
        <a class="header-menu-item mobile-parent-link" href="{{ routes.all_products_collection_url }}">Shop Desk Gear</a>
        <div class="mobile-submenu-list">
          <a class="mobile-submenu-item" href="{{ routes.all_products_collection_url }}"><span class="sub-title">All Desk Gear</span></a>
          <a class="mobile-submenu-item" href="/collections/docks-hubs"><span class="sub-title">One-Cable Docks &amp; Hubs</span><span class="sub-badge">Popular</span></a>
          <a class="mobile-submenu-item" href="/collections/monitors"><span class="sub-title">Computer Screens</span></a>
          <a class="mobile-submenu-item" href="/collections/stands"><span class="sub-title">Adjustable Laptop Stands</span></a>
          <a class="mobile-submenu-item" href="/collections/keyboards"><span class="sub-title">Comfortable Keyboards</span></a>
          <a class="mobile-submenu-item" href="/collections/mice"><span class="sub-title">Wireless Mice</span></a>
        </div>
      </div>

      <div class="mobile-menu-group" style="--item-index: 2;">
        <a class="header-menu-item mobile-parent-link" href="/pages/find-my-setup">Setup Helper</a>
        <div class="mobile-submenu-list">
          <a class="mobile-submenu-item" href="/pages/find-my-setup"><span class="sub-title">Desk Setup Finder</span><span class="sub-badge">Easy Quiz</span></a>
          <a class="mobile-submenu-item" href="/pages/compare-docks"><span class="sub-title">Compare Docks Side-by-Side</span><span class="sub-badge">Compare</span></a>
        </div>
      </div>

      <div class="mobile-menu-group" style="--item-index: 3;">
        <a class="header-menu-item mobile-parent-link" href="/pages/compatibility-faq">Help &amp; Delivery</a>
        <div class="mobile-submenu-list">
          <a class="mobile-submenu-item" href="/pages/compatibility-faq"><span class="sub-title">Will It Work With My Laptop? (FAQ)</span></a>
          <a class="mobile-submenu-item" href="/pages/about"><span class="sub-title">Who We Are</span></a>
          <a class="mobile-submenu-item" href="{{ routes.root_url }}policies/shipping-policy"><span class="sub-title">UK Shipping &amp; Free Delivery</span></a>
          <a class="mobile-submenu-item" href="{{ routes.root_url }}policies/refund-policy"><span class="sub-title">30-Day Money-Back Guarantee</span></a>
          <a class="mobile-submenu-item" href="{{ routes.root_url }}policies/privacy-policy"><span class="sub-title">Privacy Policy</span></a>
          <a class="mobile-submenu-item" href="{{ routes.root_url }}policies/terms-of-service"><span class="sub-title">Terms of Service</span></a>
        </div>
      </div>

      <div class="mobile-menu-group" style="--item-index: 4;">
        <a class="header-menu-item mobile-parent-link" href="/blogs/journal">Desk Tips &amp; Guides</a>
      </div>
    </nav>
  </aside>
</div>

<script>
  (function () {
    var aside = document.getElementById('nexa-mobile-aside');
    if (aside) aside.style.display = 'none';

    window.nexaToggleMobileMenu = function (open) {
      var a = document.getElementById('nexa-mobile-aside');
      if (!a) return;
      a.style.display = open ? 'block' : 'none';
      a.setAttribute('aria-hidden', open ? 'false' : 'true');
      document.body.style.overflow = open ? 'hidden' : '';
    };

    // Scroll-morph: toggles .is-scrolled after 30px, exactly like Header.jsx
    var header = document.getElementById('nexa-header');
    function onScroll() {
      if (!header) return;
      header.classList.toggle('is-scrolled', window.scrollY > 30);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Desktop dropdown hover with 150ms close delay
    document.querySelectorAll('.nav-item-dropdown-wrapper').forEach(function (w) {
      var t;
      w.addEventListener('mouseenter', function () { clearTimeout(t); w.classList.add('is-open'); });
      w.addEventListener('mouseleave', function () { t = setTimeout(function () { w.classList.remove('is-open'); }, 150); });
    });

    // Cart badge bounce when count changes
    var badge = document.getElementById('cart-count-badge');
    if (badge && window.subscribe && window.PUB_SUB_EVENTS) {
      window.subscribe(window.PUB_SUB_EVENTS.cartUpdate, function () {
        fetch('/cart.js').then(function (r) { return r.json(); }).then(function (c) {
          badge.textContent = c.item_count;
          badge.classList.add('is-bouncing');
          setTimeout(function () { badge.classList.remove('is-bouncing'); }, 500);
        }).catch(function () {});
      });
    }
  })();
</script>

