<section class="customer-showcase-section page-width" data-section-id="{{ section.id }}" aria-label="Real UK Customer Workstation Stories">
  <div class="customer-showcase-container">
    <div class="showcase-header">
      <div class="showcase-header-pill">
        <span class="showcase-pulse-dot pulse-dot-small" aria-hidden="true"></span>
        <span class="showcase-badge-text">Real UK Customer Stories</span>
      </div>

      <h2 class="showcase-title">
        See how people across the UK transformed their desks.
      </h2>

      <p class="showcase-subtitle">
        Tap the glowing dots on any photo below to see the exact one-cable docks, screens, and ergonomic stands they used to get rid of wire clutter.
      </p>

      <div class="showcase-nav-controls">
        <button class="showcase-nav-arrow prev" onclick="switchShowcase(-1)" aria-label="Previous story">&#8592;</button>
        <div class="showcase-dots" id="sc-nav-dots">
          <!-- Dots rendered by JS -->
        </div>
        <button class="showcase-nav-arrow next" onclick="switchShowcase(1)" aria-label="Next story">&#8594;</button>
      </div>
    </div>

    <div class="showcase-main-card">
      <div class="showcase-card-grid">
        
        <!-- Left: Interactive Visual Area -->
        <div class="showcase-visual-wrapper">
          <div class="showcase-interactive-stage">
            <div class="stage-desk-surface">
              <!-- Desk Mockup Elements -->
              <div class="desk-mockup-monitor">
                <div class="desk-mockup-screen">
                  <div class="screen-wireframe-bar"></div>
                  <div class="screen-wireframe-grid"><span></span><span></span></div>
                </div>
              </div>
              <div class="desk-mockup-arm"></div>
              
              <div class="desk-mockup-laptop">
                <div class="mockup-laptop-lid">
                  <div class="laptop-lid-logo">💻</div>
                </div>
                <div class="mockup-laptop-base"></div>
              </div>
              
              <div class="desk-mockup-dock">
                <div class="dock-led"></div>
              </div>
              
              <div class="desk-mockup-keyboard">
                <div class="kb-space"></div>
              </div>
              
              <div class="desk-mockup-mouse"></div>
              
              <svg class="desk-cable-line" viewBox="0 0 280 80" fill="none">
                <path d="M 0 50 Q 140 100 280 20" stroke="rgba(255,255,255,0.15)" stroke-width="2" fill="none" />
              </svg>

              <!-- Hotspots Layer -->
              <div id="showcase-hotspots-layer"></div>
            </div>
          </div>
          
          <div class="hotspot-helper-hint">
            <span class="pulse-dot-small"></span> Tap the pulsing dots on the desk to see gear details
          </div>
        </div>

        <!-- Right: Story Content -->
        <div class="showcase-story-content">
          <div class="story-meta-row">
            <span class="story-stars">★★★★★</span>
            <span class="story-verified-badge" id="sc-verified"></span>
          </div>
          
          <blockquote class="story-quote" id="sc-quote"></blockquote>
          
          <div class="story-author-details">
            <div class="author-avatar-initials" id="sc-initials"></div>
            <div class="author-text">
              <span class="author-name" id="sc-name"></span>
              <span class="author-role" id="sc-role"></span>
            </div>
          </div>
          
          <div class="story-device-card">
            <div class="device-icon-box">💻</div>
            <div class="device-info">
              <span class="device-title">Tested On</span>
              <span class="device-name" id="sc-device"></span>
            </div>
            <span class="device-check-pill">100% Compatible</span>
          </div>
          
          <div class="story-gear-list">
            <div class="gear-list-header-row">
              <span class="gear-list-header">Gear Used In This Setup</span>
              <div class="gear-scroll-arrows">
                <button class="gear-scroll-arrow-btn" onclick="document.getElementById('sc-gear-wrap').scrollBy(-100,0)">&lsaquo;</button>
                <button class="gear-scroll-arrow-btn" onclick="document.getElementById('sc-gear-wrap').scrollBy(100,0)">&rsaquo;</button>
              </div>
            </div>
            <div class="gear-chips-scroll-container">
              <div class="gear-chips-wrap" id="sc-gear-wrap"></div>
            </div>
          </div>
          
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  const SHOWCASE_DATA = [
    {
      name: 'Sophie M.',
      initials: 'SM',
      role: 'Remote Accountant',
      device: 'Apple MacBook Air',
      verified: 'Verified UK Order • Edinburgh, Scotland',
      quote: '"Before this, I had four separate tangled plugs all over my desk. Now when I sit down, I just plug in one single cord. Both my big monitors light up and my MacBook charges fast. My workspace feels so peaceful now."',
      hotspots: [
        {
          title: 'NexaDesk Dual Dock',
          category: 'Desk Power Hub',
          price: '£169.00',
          top: '48%',
          left: '52%',
          direction: 'open-downwards',
          benefit: 'Plugs straight into the wall to charge her MacBook and run two big screens.'
        },
        {
          title: 'Eye-Level Laptop Stand',
          category: 'Laptop Riser',
          price: '£49.00',
          top: '38%',
          left: '26%',
          direction: 'open-upwards',
          benefit: 'Brings her screen to comfortable eye height so her neck does not hurt by 5 PM.'
        },
        {
          title: 'Clear & Crisp 27" Monitor',
          category: 'Wide Screen',
          price: '£229.00',
          top: '20%',
          left: '46%',
          direction: 'open-upwards',
          benefit: 'Flicker-free glass with big, easy-to-read text that prevents tired eyes.'
        }
      ]
    },
    {
      name: 'David K.',
      initials: 'DK',
      role: '3D Designer',
      device: 'Windows Dell XPS',
      verified: 'Verified UK Order • London, England',
      quote: '"My work laptop is power-hungry and cheap adapters always got burning hot or wouldn\'t charge the battery. This hub powers my laptop without breaking a sweat, even during heavy rendering."',
      hotspots: [
        {
          title: 'High-Power Pro Dock',
          category: 'Heavy-Duty Hub',
          price: '£219.00',
          top: '48%',
          left: '52%',
          direction: 'open-downwards',
          benefit: 'Sends rapid, safe power into demanding Windows laptops.'
        },
        {
          title: 'Wireless Trackball Mouse',
          category: 'Ergonomic Mouse',
          price: '£49.00',
          top: '72%',
          left: '72%',
          direction: 'open-upwards align-right',
          benefit: 'You move the ball with your thumb instead of sliding your wrist.'
        },
        {
          title: 'Extra Wide Curved Screen',
          category: 'Panoramic Screen',
          price: '£389.00',
          top: '20%',
          left: '46%',
          direction: 'open-upwards',
          benefit: 'Wraps gently around your eyesight so you can view all windows side by side.'
        }
      ]
    },
    {
      name: 'Emma R.',
      initials: 'ER',
      role: 'Online Project Manager',
      device: 'Apple MacBook Pro',
      verified: 'Verified UK Order • Bristol, England',
      quote: '"Moving from messy wires on the dining table to this clean desk made working from home a joy. No more scrambling for adapters five minutes before a team video call."',
      hotspots: [
        {
          title: 'Standard One-Cable Dock',
          category: 'Compact Hub',
          price: '£119.00',
          top: '48%',
          left: '52%',
          direction: 'open-downwards',
          benefit: 'Tucks neatly under the screen riser and powers everything silently.'
        },
        {
          title: 'Quiet Typing Keyboard',
          category: 'Silent Keyboard',
          price: '£59.00',
          top: '75%',
          left: '40%',
          direction: 'open-upwards',
          benefit: 'Soft, quiet keys with real Apple Mac shortcut buttons.'
        }
      ]
    },
    {
      name: 'James L.',
      initials: 'JL',
      role: 'Remote Software Engineer',
      device: 'Shared Mac & PC',
      verified: 'Verified UK Order • Cambridge, England',
      quote: '"I use an Apple MacBook for work and my partner uses a Windows laptop. We share the same desk without ever having to swap cables or fiddle with settings. One cable fits both machines."',
      hotspots: [
        {
          title: 'Universal Dual Dock',
          category: 'Universal Hub',
          price: '£169.00',
          top: '48%',
          left: '52%',
          direction: 'open-downwards',
          benefit: 'Works automatically with both Apple Mac and Windows without installing any software.'
        }
      ]
    }
  ];

  let currentShowcaseIdx = 0;

  function switchShowcase(offset) {
    if (typeof offset === 'number' && (offset === 1 || offset === -1)) {
      currentShowcaseIdx += offset;
      if (currentShowcaseIdx >= SHOWCASE_DATA.length) currentShowcaseIdx = 0;
      if (currentShowcaseIdx < 0) currentShowcaseIdx = SHOWCASE_DATA.length - 1;
    } else {
      currentShowcaseIdx = offset;
    }
    
    renderShowcase(currentShowcaseIdx);
  }

  function renderShowcase(idx) {
    const item = SHOWCASE_DATA[idx];
    if (!item) return;

    // Nav Dots
    const dotsContainer = document.getElementById('sc-nav-dots');
    dotsContainer.innerHTML = SHOWCASE_DATA.map((_, i) => 
      `<button class="showcase-dot ${i === idx ? 'is-active' : ''}" onclick="switchShowcase(${i})" aria-label="View story ${i+1}"></button>`
    ).join('');

    // Story Text
    document.getElementById('sc-name').textContent = item.name;
    document.getElementById('sc-role').textContent = item.role;
    document.getElementById('sc-initials').textContent = item.initials;
    document.getElementById('sc-verified').innerHTML = item.verified;
    document.getElementById('sc-quote').textContent = item.quote;
    document.getElementById('sc-device').textContent = item.device;

    // Hotspots
    const pinsLayer = document.getElementById('showcase-hotspots-layer');
    if (pinsLayer) {
      pinsLayer.innerHTML = item.hotspots.map((hs, hidx) => `
        <div class="hotspot-pin-wrapper ${hs.direction}" style="top:${hs.top}; left:${hs.left};" id="pin-wrap-${idx}-${hidx}">
          <button class="hotspot-pin-btn" onclick="togglePopover(${idx}, ${hidx})" aria-label="View ${hs.title}">
            <span class="hotspot-ripple-ring"></span>
            <span class="hotspot-center-dot"></span>
          </button>
          <div class="hotspot-popover-card" id="popover-${idx}-${hidx}" style="display:none;">
            <button class="popover-close-btn" onclick="togglePopover(${idx}, ${hidx})">&times;</button>
            <span class="popover-category">${hs.category}</span>
            <strong class="popover-title">${hs.title}</strong>
            <p class="popover-desc">${hs.benefit}</p>
            <div class="popover-bottom">
              <span class="popover-price">${hs.price}</span>
            </div>
          </div>
        </div>
      `).join('');
    }

    // Gear Chips
    const gearList = document.getElementById('sc-gear-wrap');
    if (gearList) {
      gearList.innerHTML = item.hotspots.map((hs, hidx) => `
        <button class="gear-chip-btn" onclick="togglePopover(${idx}, ${hidx}, true)">
          <span class="chip-bullet"></span>
          ${hs.title}
        </button>
      `).join('');
    }
  }

  function togglePopover(sIdx, hIdx, fromChip = false) {
    const popover = document.getElementById(`popover-${sIdx}-${hIdx}`);
    const pinWrap = document.getElementById(`pin-wrap-${sIdx}-${hIdx}`);
    if (!popover || !pinWrap) return;
    
    const isShowing = popover.style.display === 'block';
    
    // Close all
    document.querySelectorAll('.hotspot-popover-card').forEach(p => p.style.display = 'none');
    document.querySelectorAll('.hotspot-pin-wrapper').forEach(w => w.classList.remove('is-active'));
    
    // Toggle targeted
    if (!isShowing) {
      popover.style.display = 'block';
      pinWrap.classList.add('is-active');
    }
  }

  document.addEventListener('DOMContentLoaded', () => switchShowcase(0));
</script>

{% schema %}
{
  "name": "Nexa Customer Showcase",
  "settings": [],
  "presets": [
    {
      "name": "Nexa Customer Showcase"
    }
  ]
}
{% endschema %}
