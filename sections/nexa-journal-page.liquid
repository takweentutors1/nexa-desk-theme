<div class="nexa-journal-page" data-section-id="{{ section.id }}">
  <!-- Hero Section -->
  <header class="journal-hero-header">
    <nav class="journal-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span class="current">Desk Tips &amp; Journal</span>
    </nav>
    <div class="journal-badge-pill">
      <span>📚 WORKSPACE ERGONOMICS &amp; HARDWARE GUIDES</span>
    </div>
    <h1 class="journal-hero-title">NexaDesk Journal &amp; Workspace Guides</h1>
    <p class="journal-hero-lead">
      Practical engineering and ergonomic advice on dual-screen setups, laptop charging safety, cable concealment, and healthy workday habits.
    </p>

    <!-- Category Filter Tabs -->
    <div class="journal-filter-pills">
      <button type="button" class="j-filter-btn active" onclick="filterJournal('all', this)">All Articles</button>
      <button type="button" class="j-filter-btn" onclick="filterJournal('mac', this)"> Mac Compatibility</button>
      <button type="button" class="j-filter-btn" onclick="filterJournal('ergonomics', this)">🌿 Ergonomics &amp; Posture</button>
      <button type="button" class="j-filter-btn" onclick="filterJournal('docks', this)">⚡ Docks &amp; Charging</button>
    </div>
  </header>

  <!-- Featured / Grid Articles -->
  <div class="journal-articles-grid" id="journal-articles-grid">
    <!-- Article 1: Dual 4K Screens Mac -->
    <article class="journal-card" data-category="mac">
      <div class="journal-card-media">
        <img src="https://images.unsplash.com/photo-1593642702821-c8da6771f0c6?auto=format&fit=crop&w=1200&q=80" alt="Dual 4K workstation setup" loading="lazy" />
        <span class="journal-tag-pill tag-mac"> Mac Compatibility</span>
      </div>
      <div class="journal-card-body">
        <div class="journal-meta-row">
          <span>4 min read</span>
          <span>&bull;</span>
          <span>By NexaDesk Engineering Team</span>
        </div>
        <h2 class="journal-card-title">How to Connect Dual 4K Screens to a Mac Without Driver Glitches</h2>
        <p class="journal-card-excerpt">
          Why macOS handles multi-stream transport (MST) differently from Windows, and how our D2 Link 100 dock powers dual independent 4K extended screens without CPU-heavy DisplayLink software.
        </p>
        <div class="journal-card-footer">
          <a href="/pages/compatibility-faq" class="btn-read-guide">
            <span>Read Hardware Guide</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </article>

    <!-- Article 2: Ergonomic Blueprint -->
    <article class="journal-card" data-category="ergonomics">
      <div class="journal-card-media">
        <img src="https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?auto=format&fit=crop&w=1200&q=80" alt="Ergonomic tidy workspace with laptop riser" loading="lazy" />
        <span class="journal-tag-pill tag-ergo">🌿 Ergonomics &amp; Posture</span>
      </div>
      <div class="journal-card-body">
        <div class="journal-meta-row">
          <span>5 min read</span>
          <span>&bull;</span>
          <span>By Workplace Wellness Specialists</span>
        </div>
        <h2 class="journal-card-title">The Ergonomic Desk Blueprint: Banishing Neck Strain &amp; Cable Clutter</h2>
        <p class="journal-card-excerpt">
          Learn the 90-degree forearm rule, eye-level monitor positioning, and why single-cable docking clears mental space for prolonged focus sessions.
        </p>
        <div class="journal-card-footer">
          <a href="/pages/find-my-setup" class="btn-read-guide">
            <span>Explore Setup Blueprint</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </article>

    <!-- Article 3: USB-C Alt Mode vs Thunderbolt -->
    <article class="journal-card" data-category="docks">
      <div class="journal-card-media">
        <img src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=1200&q=80" alt="Close up of high speed USB-C cable and docking station" loading="lazy" />
        <span class="journal-tag-pill tag-dock">⚡ Docks &amp; Charging</span>
      </div>
      <div class="journal-card-body">
        <div class="journal-meta-row">
          <span>3 min read</span>
          <span>&bull;</span>
          <span>By Hardware Testing Lab</span>
        </div>
        <h2 class="journal-card-title">USB-C Alt Mode vs Thunderbolt 4: What You Actually Need on Your Desk</h2>
        <p class="journal-card-excerpt">
          A plain-English guide decoding charging wattages, DisplayPort video bandwidth, and how to verify if your laptop USB-C port charges your battery safely.
        </p>
        <div class="journal-card-footer">
          <a href="/pages/compare-docks" class="btn-read-guide">
            <span>Compare Dock Specs</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </article>
  </div>

  <!-- Setup Quiz Call to Action Banner -->
  <section class="journal-cta-box">
    <div class="cta-inner">
      <span class="cta-badge">🎯 INTERACTIVE TOOL</span>
      <h2>Want to Know Exactly What Fits Your Computer?</h2>
      <p>Take our 30-second laptop compatibility quiz. We test and recommend the exact dock, monitor, and stand combination guaranteed for your workspace.</p>
      <a href="/pages/find-my-setup" class="btn-journal-quiz">Launch Find My Setup Quiz &rarr;</a>
    </div>
  </section>
</div>

<style>
  .nexa-journal-page {
    max-width: 1240px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 6rem;
  }
  .journal-hero-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3.5rem;
  }
  .journal-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(148, 163, 184, 0.15);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
  }
  .journal-breadcrumb a { color: #94a3b8; text-decoration: none; }
  .journal-breadcrumb a:hover { color: #d4af37; }
  .journal-breadcrumb .sep { color: #475569; }
  .journal-breadcrumb .current { color: #d4af37; font-weight: 600; }
  .journal-badge-pill {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.15), rgba(245, 158, 11, 0.05));
    border: 1px solid rgba(212, 175, 55, 0.4);
    color: #f8fafc;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
  }
  .journal-hero-title {
    font-size: clamp(2.2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1.25rem;
    background: linear-gradient(180deg, #ffffff 40%, #cbd5e1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .journal-hero-lead {
    font-size: 1.1rem;
    color: #94a3b8;
    line-height: 1.65;
    margin: 0 0 2rem;
  }
  .journal-filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
  }
  .j-filter-btn {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(148, 163, 184, 0.2);
    color: #cbd5e1;
    padding: 0.5rem 1.1rem;
    border-radius: 9999px;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .j-filter-btn:hover {
    background: rgba(30, 41, 59, 0.9);
    border-color: rgba(56, 189, 248, 0.4);
    color: #ffffff;
  }
  .j-filter-btn.active {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.25), rgba(14, 165, 233, 0.15));
    border-color: #38bdf8;
    color: #ffffff;
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.3);
  }
  .journal-articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }
  .journal-card {
    background: rgba(14, 21, 38, 0.75);
    border: 1px solid rgba(56, 189, 248, 0.18);
    border-radius: 18px;
    overflow: hidden;
    backdrop-filter: blur(14px);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  }
  .journal-card:hover {
    transform: translateY(-5px);
    border-color: rgba(56, 189, 248, 0.45);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
  }
  .journal-card-media {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: #090e1a;
  }
  .journal-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .journal-card:hover .journal-card-media img {
    transform: scale(1.05);
  }
  .journal-tag-pill {
    position: absolute;
    bottom: 12px;
    left: 12px;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 0.7rem;
    border-radius: 9999px;
    backdrop-filter: blur(8px);
  }
  .tag-mac { background: rgba(0, 0, 0, 0.7); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.2); }
  .tag-ergo { background: rgba(34, 197, 94, 0.8); color: #030712; border: 1px solid rgba(34, 197, 94, 0.3); }
  .tag-dock { background: rgba(251, 191, 36, 0.8); color: #030712; border: 1px solid rgba(251, 191, 36, 0.3); }
  .journal-card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .journal-meta-row {
    font-size: 0.8rem;
    color: #94a3b8;
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }
  .journal-card-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.35;
    margin: 0 0 0.85rem;
  }
  .journal-card-excerpt {
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 1.5rem;
    flex-grow: 1;
  }
  .btn-read-guide {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #38bdf8;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.15s;
  }
  .btn-read-guide:hover { color: #d4af37; }
  .journal-cta-box {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.85));
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 20px;
    padding: 3.5rem 2rem;
    text-align: center;
  }
  .cta-badge {
    font-size: 0.78rem;
    font-weight: 700;
    color: #fbbf24;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.75rem;
  }
  .journal-cta-box h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.75rem;
  }
  .journal-cta-box p {
    color: #94a3b8;
    font-size: 1.05rem;
    max-width: 620px;
    margin: 0 auto 1.75rem;
    line-height: 1.6;
  }
  .btn-journal-quiz {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.85rem;
    background: linear-gradient(135deg, #d4af37, #f59e0b);
    color: #030712;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.2s;
  }
  .btn-journal-quiz:hover { transform: translateY(-2px); }
</style>

<script>
  function filterJournal(cat, btn) {
    document.querySelectorAll('.j-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const cards = document.querySelectorAll('.journal-articles-grid .journal-card');
    cards.forEach(card => {
      if (cat === 'all' || card.getAttribute('data-category') === cat) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>

{% schema %}
{
  "name": "Nexa Journal Page",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Nexa Journal Page"
    }
  ]
}
{% endschema %}
