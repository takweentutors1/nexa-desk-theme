<div class="nexa-about-page" data-section-id="{{ section.id }}">
  <!-- Hero Section -->
  <header class="about-hero-header">
    <nav class="about-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span class="current">About NexaDesk UK</span>
    </nav>
    <div class="about-badge-pill">
      <span>🇬🇧 CRAFTED &amp; FULFILLED IN THE UK</span>
    </div>
    <h1 class="about-hero-title">One Cable. Zero Clutter. Uncompromised Power.</h1>
    <p class="about-hero-lead">
      We believe your desk should be a sanctuary of calm and focused creativity—not a chaotic nest of tangled black power bricks, buzzing video adapters, and fragile dongles.
    </p>
  </header>

  <!-- Mission Banner Card -->
  <div class="about-manifesto-card">
    <div class="manifesto-grid">
      <div class="manifesto-text">
        <span class="manifesto-tag">OUR ORIGIN STORY</span>
        <h2>Eliminating Workplace Friction From the Ground Up</h2>
        <p>
          Founded by computer hardware engineers and ergonomic workspace specialists in Northamptonshire, NexaDesk was built around one simple frustration: setting up dual monitors, clean power, and ergonomic laptop risers was unnecessarily confusing.
        </p>
        <p>
          Between incompatible USB-C display modes, conflicting charging wattages, and cheap adapters running hot, remote professionals were wasting hours troubleshooting. We set out to engineer precision, certified desk bundles that are guaranteed to work together flawlessly.
        </p>
        <div class="manifesto-stats-row">
          <div class="m-stat">
            <span class="m-stat-num">100%</span>
            <span class="m-stat-lbl">Tested Compatibility</span>
          </div>
          <div class="m-stat">
            <span class="m-stat-num">2-Year</span>
            <span class="m-stat-lbl">UK Hardware Warranty</span>
          </div>
          <div class="m-stat">
            <span class="m-stat-num">30-Day</span>
            <span class="m-stat-lbl">Risk-Free Desk Trial</span>
          </div>
        </div>
      </div>
      <div class="manifesto-graphic">
        <div class="graphic-card">
          <div class="graphic-icon">⚡</div>
          <h3>The Nexa Standard</h3>
          <p>Every cable, stand, and dock is bench-tested in our UK facility before dispatch.</p>
          <div class="graphic-check-list">
            <div class="check-item"><span>✓</span> 100W GaN Safe Negotiation</div>
            <div class="check-item"><span>✓</span> Uncompressed 4K@60Hz Video</div>
            <div class="check-item"><span>✓</span> Anodised Aluminum Heat Sinks</div>
            <div class="check-item"><span>✓</span> 100% Driverless Plug-and-Play</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Engineering Pillars Grid -->
  <section class="about-pillars-section">
    <div class="section-heading-center">
      <span class="sub-badge">WHAT WE STAND FOR</span>
      <h2>Built On Three Guiding Principles</h2>
    </div>
    <div class="pillars-grid">
      <div class="pillar-card">
        <div class="pillar-icon">🎯</div>
        <h3>Guaranteed Compatibility</h3>
        <p>
          Zero guesswork. Whether you run a MacBook Air, high-powered Windows CAD laptop, or dual displays, our hardware configurations are certified to eliminate compatibility headaches.
        </p>
      </div>

      <div class="pillar-card">
        <div class="pillar-icon">🌿</div>
        <h3>Ergonomic Posture & Wellness</h3>
        <p>
          We build workstations designed for 8+ hour workdays. Precision-angled aluminum stands and VESA-ready monitor positioning keep your spine aligned and neck tension at zero.
        </p>
      </div>

      <div class="pillar-card">
        <div class="pillar-icon">📦</div>
        <h3>Local UK Care & Logistics</h3>
        <p>
          Direct dispatch from our central UK logistics centre with tracked Royal Mail 24 and DPD delivery, backed by friendly UK-based product specialists who know hardware inside and out.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Call to Action Banner -->
  <section class="about-cta-banner">
    <div class="cta-inner-card">
      <span class="cta-mini-pill">✨ READY TO UPGRADE YOUR DESK?</span>
      <h2>Experience the Calm of Single-Cable Simplicity</h2>
      <p>
        Take our 30-second setup quiz or explore our certified docking station collection with our 30-day home trial.
      </p>
      <div class="cta-button-group">
        <a href="/pages/find-my-setup" class="btn-primary-gold">
          <span>Find My Laptop Setup</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/collections/all" class="btn-secondary-cyan">
          <span>Explore All Desk Gear</span>
        </a>
      </div>
    </div>
  </section>
</div>

<style>
  .nexa-about-page {
    max-width: 1240px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 6rem;
  }
  .about-hero-header {
    text-align: center;
    max-width: 840px;
    margin: 0 auto 3.5rem;
  }
  .about-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(148, 163, 184, 0.15);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
  }
  .about-breadcrumb a { color: #94a3b8; text-decoration: none; }
  .about-breadcrumb a:hover { color: #d4af37; }
  .about-breadcrumb .sep { color: #475569; }
  .about-breadcrumb .current { color: #d4af37; font-weight: 600; }
  .about-badge-pill {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.15), rgba(245, 158, 11, 0.05));
    border: 1px solid rgba(212, 175, 55, 0.4);
    color: #f8fafc;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
  }
  .about-hero-title {
    font-size: clamp(2.2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1.25rem;
    background: linear-gradient(180deg, #ffffff 40%, #cbd5e1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .about-hero-lead {
    font-size: 1.15rem;
    color: #94a3b8;
    line-height: 1.65;
    margin: 0;
  }
  .about-manifesto-card {
    background: rgba(14, 21, 38, 0.8);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 20px;
    padding: 3rem 2.5rem;
    margin-bottom: 4.5rem;
    backdrop-filter: blur(16px);
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.4);
  }
  .manifesto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .manifesto-grid { grid-template-columns: 1.2fr 0.8fr; }
  }
  .manifesto-tag {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #d4af37;
    display: block;
    margin-bottom: 0.5rem;
  }
  .manifesto-text h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 1.25rem;
    line-height: 1.25;
  }
  .manifesto-text p {
    color: #cbd5e1;
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }
  .manifesto-stats-row {
    display: flex;
    gap: 2rem;
    margin-top: 2rem;
    flex-wrap: wrap;
    border-top: 1px solid rgba(148, 163, 184, 0.15);
    padding-top: 1.5rem;
  }
  .m-stat-num {
    display: block;
    font-size: 1.85rem;
    font-weight: 800;
    color: #22c55e;
  }
  .m-stat-lbl {
    font-size: 0.82rem;
    color: #94a3b8;
    font-weight: 500;
  }
  .graphic-card {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(30, 41, 59, 0.7));
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 16px;
    padding: 2.25rem;
    text-align: center;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }
  .graphic-icon { font-size: 2.5rem; margin-bottom: 0.75rem; }
  .graphic-card h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.5rem;
  }
  .graphic-card p {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }
  .graphic-check-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    text-align: left;
  }
  .check-item {
    font-size: 0.9rem;
    color: #cbd5e1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .check-item span { color: #22c55e; font-weight: 800; }
  .about-pillars-section { margin-bottom: 4.5rem; }
  .section-heading-center {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 3rem;
  }
  .sub-badge {
    font-size: 0.8rem;
    font-weight: 700;
    color: #38bdf8;
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: 0.5rem;
  }
  .section-heading-center h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
  }
  .pillar-card {
    background: rgba(14, 21, 38, 0.7);
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 16px;
    padding: 2.25rem 2rem;
    transition: transform 0.25s, border-color 0.25s;
  }
  .pillar-card:hover {
    transform: translateY(-4px);
    border-color: rgba(56, 189, 248, 0.35);
  }
  .pillar-icon { font-size: 2.25rem; margin-bottom: 1rem; }
  .pillar-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.75rem;
  }
  .pillar-card p {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
  .about-cta-banner {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.85));
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 20px;
    padding: 3.5rem 2rem;
    text-align: center;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.4);
  }
  .cta-mini-pill {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fbbf24;
    letter-spacing: 0.05em;
    margin-bottom: 0.85rem;
  }
  .about-cta-banner h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 1rem;
  }
  .about-cta-banner p {
    color: #94a3b8;
    font-size: 1.05rem;
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }
  .cta-button-group {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-primary-gold {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.85rem;
    background: linear-gradient(135deg, #d4af37, #f59e0b);
    color: #030712;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.2s;
  }
  .btn-primary-gold:hover { transform: translateY(-2px); }
  .btn-secondary-cyan {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.85rem;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38bdf8;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-secondary-cyan:hover { background: #38bdf8; color: #030712; }
</style>

