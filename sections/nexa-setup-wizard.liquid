<div class="nexa-setup-wizard-root page-width" data-section-id="{{ section.id }}">
  <!-- Interactive Step Navigator / Horizontal Breadcrumb -->
  <nav class="wizard-stepper-navigation" aria-label="Setup Wizard Steps">
    <div class="stepper-track-line"></div>
    <button type="button" class="stepper-node is-current" id="step-nav-0" onclick="goToStep(0)">
      <div class="stepper-icon-circle">1</div>
      <div class="stepper-labels">
        <span class="step-name">Device Profile</span>
        <span class="step-sub">Choose your laptop</span>
      </div>
    </button>
    <button type="button" class="stepper-node" id="step-nav-1" onclick="goToStep(1)">
      <div class="stepper-icon-circle">2</div>
      <div class="stepper-labels">
        <span class="step-name">Connection Dock</span>
        <span class="step-sub">Power &amp; display hub</span>
      </div>
    </button>
    <button type="button" class="stepper-node" id="step-nav-2" onclick="goToStep(2)">
      <div class="stepper-icon-circle">3</div>
      <div class="stepper-labels">
        <span class="step-name">Monitor Display</span>
        <span class="step-sub">Primary workspace screen</span>
      </div>
    </button>
    <button type="button" class="stepper-node" id="step-nav-3" onclick="goToStep(3)">
      <div class="stepper-icon-circle">4</div>
      <div class="stepper-labels">
        <span class="step-name">Ergonomics</span>
        <span class="step-sub">Keyboards &amp; stands</span>
      </div>
    </button>
    <button type="button" class="stepper-node" id="step-nav-4" onclick="goToStep(4)">
      <div class="stepper-icon-circle">5</div>
      <div class="stepper-labels">
        <span class="step-name">Review Setup</span>
        <span class="step-sub">Summary &amp; checkout</span>
      </div>
    </button>
  </nav>

  <!-- Main Split-Pane Workspace: Left Configurator / Right Live CAD Blueprint -->
  <div class="wizard-split-layout">
    <div class="wizard-config-pane">
      <div class="step-content-animator">
        <!-- STEP 0: DEVICE PROFILE -->
        <div class="wizard-step-pane" id="wizard-pane-0" style="display:block;">
          <div class="pane-header">
            <span class="pane-step-counter">Step 1 of 5</span>
            <h2 class="pane-title">What Laptop Or Computer Are You Using?</h2>
            <p class="pane-desc">
              We match the exact charging wattage, host connector, and video protocol your computer requires.
            </p>
          </div>

          <div class="device-cards-grid">
            <!-- P1: Studio 65 Windows -->
            <button type="button" class="setup-profile-card" id="wiz-card-P1" onclick="wizSelectProfile('P1')">
              <div class="card-top-row">
                <div class="profile-brand-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/></svg>
                </div>
                <span class="profile-code-pill">P1</span>
              </div>
              <div class="profile-text-content">
                <h3 class="profile-title">Studio 65 (Windows)</h3>
                <span class="profile-sub">Dell, Lenovo, HP, Surface Laptop</span>
                <p class="profile-description">Everyday Windows laptops with USB-C. Charges up to 65W with full multi-screen support.</p>
              </div>
              <div class="profile-spec-badges">
                <span class="spec-chip">🔌 USB-C</span>
                <span class="spec-chip">⚡ 65W Charge</span>
                <span class="spec-chip chip-green">🖥️ Display Support</span>
              </div>
              <div class="card-footer-action">
                <span class="select-prompt">Select &amp; Find Docks &rarr;</span>
              </div>
            </button>

            <!-- P2: Studio 100 Windows -->
            <button type="button" class="setup-profile-card" id="wiz-card-P2" onclick="wizSelectProfile('P2')">
              <div class="card-top-row">
                <div class="profile-brand-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                </div>
                <span class="profile-code-pill">P2</span>
              </div>
              <div class="profile-text-content">
                <h3 class="profile-title">Studio 100 (Windows)</h3>
                <span class="profile-sub">Gaming PC, Workstation &amp; Creative Laptop</span>
                <p class="profile-description">High-performance laptops requiring full 100W Power Delivery to stay charged under heavy compute load.</p>
              </div>
              <div class="profile-spec-badges">
                <span class="spec-chip">🔌 USB-C</span>
                <span class="spec-chip">⚡ 100W Charge</span>
                <span class="spec-chip chip-green">🖥️ Display Support</span>
              </div>
              <div class="card-footer-action">
                <span class="select-prompt">Select &amp; Find Docks &rarr;</span>
              </div>
            </button>

            <!-- P3: Creator 65 macOS -->
            <button type="button" class="setup-profile-card" id="wiz-card-P3" onclick="wizSelectProfile('P3')">
              <div class="card-top-row">
                <div class="profile-brand-icon">
                  <svg width="24" height="24" viewBox="0 0 170 170" fill="currentColor"><path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.69-3.04-7.69-7.85-12-14.42-6.2-9.35-11.05-19.8-14.56-31.35-3.51-11.55-5.27-22.37-5.27-32.48 0-14.13 3.63-25.75 10.88-34.86 7.25-9.11 16.48-13.84 27.69-14.19 4.35 0 9.28 1.16 14.78 3.49 5.51 2.32 9.49 3.55 11.96 3.69 2.22 0 6.54-1.37 12.96-4.12 6.42-2.75 11.96-3.91 16.61-3.49 12.52.95 22.42 5.63 29.69 14.04-10.97 6.64-16.35 15.68-16.14 27.12.21 9.07 3.73 16.66 10.56 22.77 6.83 6.11 14.72 9.69 23.68 10.74-2.22 6.96-5.01 14.03-8.36 21.23zM119.22 31.84c0-7.39 2.68-14.28 8.04-20.67 5.36-6.39 12.01-10.45 19.95-12.17.21 1.06.32 2.01.32 2.85 0 7.39-2.82 14.39-8.46 21-5.63 6.6-12.35 10.45-20.16 11.55-.1-1.05-.15-2.02-.15-2.91l.46.35z"/></svg>
                </div>
                <span class="profile-code-pill">P3</span>
              </div>
              <div class="profile-text-content">
                <h3 class="profile-title">Creator 65 (macOS)</h3>
                <span class="profile-sub">MacBook Air, MacBook Pro, Mac mini</span>
                <p class="profile-description">Apple Silicon or Intel Mac with Thunderbolt / USB-C ports. Fast one-cable charging and dual display.</p>
              </div>
              <div class="profile-spec-badges">
                <span class="spec-chip">🔌 USB-C</span>
                <span class="spec-chip">⚡ 65W Charge</span>
                <span class="spec-chip chip-green">🖥️ Display Support</span>
              </div>
              <div class="card-footer-action">
                <span class="select-prompt">Select &amp; Find Docks &rarr;</span>
              </div>
            </button>

            <!-- P4: Classic A Windows -->
            <button type="button" class="setup-profile-card" id="wiz-card-P4" onclick="wizSelectProfile('P4')">
              <div class="card-top-row">
                <div class="profile-brand-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v10M12 12l4-4M12 12L8 8"/><rect x="7" y="14" width="10" height="8" rx="1"/></svg>
                </div>
                <span class="profile-code-pill">P4</span>
              </div>
              <div class="profile-text-content">
                <h3 class="profile-title">Classic A (Windows)</h3>
                <span class="profile-sub">Legacy PC with rectangular USB-A port</span>
                <p class="profile-description">Older machines with traditional rectangular USB ports. Connects data and peripherals (no native video).</p>
              </div>
              <div class="profile-spec-badges">
                <span class="spec-chip">🔌 USB-A</span>
                <span class="spec-chip">⚡ 0W Charge</span>
                <span class="spec-chip chip-amber">⚠️ No Native Video</span>
              </div>
              <div class="card-footer-action">
                <span class="select-prompt">Select &amp; Find Docks &rarr;</span>
              </div>
            </button>
          </div>
        </div>

        <!-- STEP 1: DOCKS -->
        <div class="wizard-step-pane" id="wizard-pane-1" style="display:none;">
          <div class="pane-header">
            <span class="pane-step-counter">Step 2 of 5</span>
            <h2 class="pane-title">Choose Your One-Cable Connection Dock</h2>
            <p class="pane-desc">Matched to power your computer at full speed while driving external displays.</p>
          </div>

          <div class="docks-selector-grid">
            <!-- D1 -->
            <div class="setup-dock-card" id="dock-card-d1">
              <div class="dock-img-box">
                {%- if collections.all.products -%}
                  {%- assign d1_prod = collections.all.products | where: 'handle', 'd1-link-65' | first -%}
                  {%- if d1_prod.featured_media -%}
                    <img src="{{ d1_prod.featured_media | image_url: width: 400 }}" alt="D1 Link 65" loading="lazy" width="400" height="260" class="wiz-card-thumb">
                  {%- else -%}
                    <div class="wiz-dock-avatar">⚡</div>
                  {%- endif -%}
                {%- else -%}
                  <div class="wiz-dock-avatar">⚡</div>
                {%- endif -%}
              </div>
              <div class="dock-card-header">
                <span class="dock-role-badge">Full Dock</span>
                <span class="dock-price">£99.00</span>
              </div>
              <div class="dock-title-block">
                <h3 class="dock-title">D1 Link 65 Standard Dock</h3>
                <p class="dock-desc">Reliable desktop dock with up to 65W charging and crisp 4K HDMI video output for single screens.</p>
              </div>
              <div class="dock-hardware-specs">
                <div class="spec-cell"><span class="spec-label">Power Delivery</span><strong class="spec-val">⚡ 65W</strong></div>
                <div class="spec-cell"><span class="spec-label">Display Outputs</span><strong class="spec-val">🖥️ HDMI</strong></div>
                <div class="spec-cell"><span class="spec-label">Host Connection</span><strong class="spec-val">🔌 USB-C</strong></div>
              </div>
              <div class="dock-card-footer">
                <button type="button" class="btn-select-component" onclick="wizSelectDock('d1')">Select This Dock &rarr;</button>
              </div>
            </div>

            <!-- D2 -->
            <div class="setup-dock-card" id="dock-card-d2">
              <div class="dock-img-box">
                {%- if collections.all.products -%}
                  {%- assign d2_prod = collections.all.products | where: 'handle', 'd2-link-100-silver' | first -%}
                  {%- if d2_prod.featured_media -%}
                    <img src="{{ d2_prod.featured_media | image_url: width: 400 }}" alt="D2 Link 100" loading="lazy" width="400" height="260" class="wiz-card-thumb">
                  {%- else -%}
                    <div class="wiz-dock-avatar">🖥️</div>
                  {%- endif -%}
                {%- else -%}
                  <div class="wiz-dock-avatar">🖥️</div>
                {%- endif -%}
              </div>
              <div class="dock-card-header">
                <span class="dock-role-badge">Full Dock</span>
                <span class="dock-price">£120.00</span>
              </div>
              <div class="dock-title-block">
                <h3 class="dock-title">D2 Link 100 Dual-Screen Flagship Dock</h3>
                <p class="dock-desc">Our top-tier dock. Sustained 100W Power Delivery and dual video feeds (HDMI + DP) for power users.</p>
              </div>
              <div class="dock-hardware-specs">
                <div class="spec-cell"><span class="spec-label">Power Delivery</span><strong class="spec-val">⚡ 100W</strong></div>
                <div class="spec-cell"><span class="spec-label">Display Outputs</span><strong class="spec-val">🖥️ HDMI &amp; DP</strong></div>
                <div class="spec-cell"><span class="spec-label">Host Connection</span><strong class="spec-val">🔌 USB-C</strong></div>
              </div>
              <div class="dock-card-footer">
                <button type="button" class="btn-select-component" onclick="wizSelectDock('d2')">Select This Dock &rarr;</button>
              </div>
            </div>

            <!-- D3 -->
            <div class="setup-dock-card" id="dock-card-d3">
              <div class="dock-img-box">
                {%- if collections.all.products -%}
                  {%- assign d3_prod = collections.all.products | where: 'handle', 'd3-pro-100' | first -%}
                  {%- if d3_prod.featured_media -%}
                    <img src="{{ d3_prod.featured_media | image_url: width: 400 }}" alt="D3 Pro 100" loading="lazy" width="400" height="260" class="wiz-card-thumb">
                  {%- else -%}
                    <div class="wiz-dock-avatar">🚀</div>
                  {%- endif -%}
                {%- else -%}
                  <div class="wiz-dock-avatar">🚀</div>
                {%- endif -%}
              </div>
              <div class="dock-card-header">
                <span class="dock-role-badge">Full Dock</span>
                <span class="dock-price">£149.00</span>
              </div>
              <div class="dock-title-block">
                <h3 class="dock-title">D3 Pro 100 High-Speed Workstation Dock</h3>
                <p class="dock-desc">Built exclusively for demanding Windows workstations requiring enterprise DisplayPort &amp; 100W PD.</p>
              </div>
              <div class="dock-hardware-specs">
                <div class="spec-cell"><span class="spec-label">Power Delivery</span><strong class="spec-val">⚡ 100W</strong></div>
                <div class="spec-cell"><span class="spec-label">Display Outputs</span><strong class="spec-val">🖥️ DisplayPort</strong></div>
                <div class="spec-cell"><span class="spec-label">Host Connection</span><strong class="spec-val">🔌 USB-C</strong></div>
              </div>
              <div class="dock-card-footer">
                <button type="button" class="btn-select-component" onclick="wizSelectDock('d3')">Select This Dock &rarr;</button>
              </div>
            </div>

            <!-- D4 -->
            <div class="setup-dock-card" id="dock-card-d4">
              <div class="dock-img-box">
                {%- if collections.all.products -%}
                  {%- assign d4_prod = collections.all.products | where: 'handle', 'd4-connect-a' | first -%}
                  {%- if d4_prod.featured_media -%}
                    <img src="{{ d4_prod.featured_media | image_url: width: 400 }}" alt="D4 Connect A" loading="lazy" width="400" height="260" class="wiz-card-thumb">
                  {%- else -%}
                    <div class="wiz-dock-avatar">🔌</div>
                  {%- endif -%}
                {%- else -%}
                  <div class="wiz-dock-avatar">🔌</div>
                {%- endif -%}
              </div>
              <div class="dock-card-header">
                <span class="dock-role-badge">Peripheral Hub</span>
                <span class="dock-price">£59.00</span>
              </div>
              <div class="dock-title-block">
                <h3 class="dock-title">D4 Connect A Legacy Peripheral Hub</h3>
                <p class="dock-desc">Legacy USB-A peripheral hub for keyboard, mouse, and storage. Does not support video displays.</p>
              </div>
              <div class="dock-hardware-specs">
                <div class="spec-cell"><span class="spec-label">Power Delivery</span><strong class="spec-val">⚡ 0W</strong></div>
                <div class="spec-cell"><span class="spec-label">Display Outputs</span><strong class="spec-val">None</strong></div>
                <div class="spec-cell"><span class="spec-label">Host Connection</span><strong class="spec-val">🔌 USB-A</strong></div>
              </div>
              <div class="dock-card-footer">
                <button type="button" class="btn-select-component" onclick="wizSelectDock('d4')">Select This Dock &rarr;</button>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 2: MONITORS -->
        <div class="wizard-step-pane" id="wizard-pane-2" style="display:none;">
          <div class="pane-header">
            <span class="pane-step-counter">Step 3 of 5</span>
            <h2 class="pane-title">Add A High-Definition Computer Screen</h2>
            <p class="pane-desc">Filtered to displays that connect directly to your dock's video outputs.</p>
          </div>

          <div class="monitors-selector-grid">
            <!-- M1 -->
            <div class="setup-monitor-card" id="mon-card-m1">
              <div class="dock-img-box">
                {%- if collections.all.products -%}
                  {%- assign m1_prod = collections.all.products | where: 'handle', 'm1-27-inch-hdmi-productivity-monitor' | first -%}
                  {%- if m1_prod == blank -%}
                    {%- assign m1_prod = collections.all.products | where: 'handle', 'm1-studio-27' | first -%}
                  {%- endif -%}
                  {%- if m1_prod.featured_media -%}
                    <img src="{{ m1_prod.featured_media | image_url: width: 400 }}" alt="M1 27-inch" loading="lazy" width="400" height="260" class="wiz-card-thumb">
                  {%- else -%}
                    <div class="wiz-dock-avatar">🖥️</div>
                  {%- endif -%}
                {%- else -%}
                  <div class="wiz-dock-avatar">🖥️</div>
                {%- endif -%}
              </div>
              <div class="monitor-card-header"><span class="monitor-tag">HDMI Ready</span><span class="monitor-price">£145.00</span></div>
              <div class="monitor-title-block">
                <h3 class="monitor-title">M1 27-inch HDMI Productivity Monitor</h3>
                <span class="monitor-res">4K IPS (3840 x 2160)</span>
                <p class="monitor-desc">Crystal-clear 27" IPS screen with vibrant colour and native HDMI input. Anti-glare eye protection.</p>
              </div>
              <div class="monitor-specs-strip">
                <span class="spec-chip">Screen: 27-inch</span>
                <span class="spec-chip">Video: HDMI</span>
              </div>
              <div class="monitor-card-footer">
                <button type="button" class="btn-select-component" onclick="wizSelectMonitor('m1')">Select This Screen &rarr;</button>
              </div>
            </div>

            <!-- M2 -->
            <div class="setup-monitor-card" id="mon-card-m2">
              <div class="dock-img-box">
                {%- if collections.all.products -%}
                  {%- assign m2_prod = collections.all.products | where: 'handle', 'm2-27-inch-displayport-monitor-high-refresh' | first -%}
                  {%- if m2_prod == blank -%}
                    {%- assign m2_prod = collections.all.products | where: 'handle', 'm2-view-32' | first -%}
                  {%- endif -%}
                  {%- if m2_prod.featured_media -%}
                    <img src="{{ m2_prod.featured_media | image_url: width: 400 }}" alt="M2 27-inch" loading="lazy" width="400" height="260" class="wiz-card-thumb">
                  {%- else -%}
                    <div class="wiz-dock-avatar">🖥️</div>
                  {%- endif -%}
                {%- else -%}
                  <div class="wiz-dock-avatar">🖥️</div>
                {%- endif -%}
              </div>
              <div class="monitor-card-header"><span class="monitor-tag">DisplayPort Exclusive</span><span class="monitor-price">£189.00</span></div>
              <div class="monitor-title-block">
                <h3 class="monitor-title">M2 27-inch DisplayPort High-Refresh Monitor</h3>
                <span class="monitor-res">4K 144Hz (3840 x 2160)</span>
                <p class="monitor-desc">Silky smooth 144Hz refresh rate with dedicated DisplayPort input, tailored for CAD, 3D design, and coding.</p>
              </div>
              <div class="monitor-specs-strip">
                <span class="spec-chip">Screen: 27-inch</span>
                <span class="spec-chip">Video: DisplayPort</span>
              </div>
              <div class="monitor-card-footer">
                <button type="button" class="btn-select-component" onclick="wizSelectMonitor('m2')">Select This Screen &rarr;</button>
              </div>
            </div>

            <!-- M3 -->
            <div class="setup-monitor-card" id="mon-card-m3">
              <div class="dock-img-box">
                {%- if collections.all.products -%}
                  {%- assign m3_prod = collections.all.products | where: 'handle', 'm3-27-inch-usb-c-monitor-hdmi-dp' | first -%}
                  {%- if m3_prod == blank -%}
                    {%- assign m3_prod = collections.all.products | where: 'handle', 'm3-dual-curved' | first -%}
                  {%- endif -%}
                  {%- if m3_prod.featured_media -%}
                    <img src="{{ m3_prod.featured_media | image_url: width: 400 }}" alt="M3 27-inch" loading="lazy" width="400" height="260" class="wiz-card-thumb">
                  {%- else -%}
                    <div class="wiz-dock-avatar">🖥️</div>
                  {%- endif -%}
                {%- else -%}
                  <div class="wiz-dock-avatar">🖥️</div>
                {%- endif -%}
              </div>
              <div class="monitor-card-header"><span class="monitor-tag">Universal HDMI &amp; DP</span><span class="monitor-price">£250.00</span></div>
              <div class="monitor-title-block">
                <h3 class="monitor-title">M3 27-inch Universal Dual-Input Monitor</h3>
                <span class="monitor-res">5K Retina Clarity (5120 x 2880)</span>
                <p class="monitor-desc">Universal compatibility with both HDMI and DisplayPort inputs. Matches seamlessly with any dock output.</p>
              </div>
              <div class="monitor-specs-strip">
                <span class="spec-chip">Screen: 27-inch</span>
                <span class="spec-chip">Video: HDMI &amp; DisplayPort</span>
              </div>
              <div class="monitor-card-footer">
                <button type="button" class="btn-select-component" onclick="wizSelectMonitor('m3')">Select This Screen &rarr;</button>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 3: ACCESSORIES -->
        <div class="wizard-step-pane" id="wizard-pane-3" style="display:none;">
          <div class="pane-header">
            <span class="pane-step-counter">Step 4 of 5 (Optional)</span>
            <h2 class="pane-title">Ergonomic Peripherals &amp; Desk Accessories</h2>
            <p class="pane-desc">Universal plug-and-play accessories designed to eliminate neck strain and wrist soreness.</p>
          </div>

          <div class="accessories-selector-grid">
            <div class="accessory-card" id="acc-card-s1">
              <div class="acc-card-header"><span class="acc-category">Stands</span><span class="acc-price">£35.00</span></div>
              <h3 class="acc-title">S1 Fixed Tilt Aluminium Laptop Stand</h3>
              <p class="acc-desc">Minimalist brushed aluminium stand raising your laptop screen to comfortable eye level.</p>
              <button type="button" class="btn-toggle-accessory" onclick="wizToggleAccessory('s1')">+ Add to Setup</button>
            </div>

            <div class="accessory-card" id="acc-card-k1">
              <div class="acc-card-header"><span class="acc-category">Keyboards</span><span class="acc-price">£69.00</span></div>
              <h3 class="acc-title">K1 Precision Mechanical Keyboard</h3>
              <p class="acc-desc">Smooth tactile switches with universal Mac &amp; Windows keycaps and anodised top plate.</p>
              <button type="button" class="btn-toggle-accessory" onclick="wizToggleAccessory('k1')">+ Add to Setup</button>
            </div>

            <div class="accessory-card" id="acc-card-m2">
              <div class="acc-card-header"><span class="acc-category">Mice</span><span class="acc-price">£39.00</span></div>
              <h3 class="acc-title">M-2 Ergonomic Vertical Handshake Mouse</h3>
              <p class="acc-desc">Natural 57-degree handshake grip preventing forearm twisting and repetitive wrist strain.</p>
              <button type="button" class="btn-toggle-accessory" onclick="wizToggleAccessory('m2')">+ Add to Setup</button>
            </div>
          </div>

          <div class="step-footer-cta-row">
            <button type="button" class="btn-primary btn-large-proceed" onclick="goToStep(4)">Proceed to Setup Review &rarr;</button>
          </div>
        </div>

        <!-- STEP 4: REVIEW & BUNDLE -->
        <div class="wizard-step-pane" id="wizard-pane-4" style="display:none;">
          <div class="pane-header">
            <span class="pane-step-counter">Final Step</span>
            <h2 class="pane-title">Review Your Complete Desk Workstation</h2>
            <p class="pane-desc">All components are tested, verified for compatibility, and packaged with next-day UK dispatch.</p>
          </div>

          <div class="review-setup-grid">
            <div class="setup-summary-breakdown">
              <div class="summary-block">
                <div class="summary-block-header"><span class="block-label">Computer / Host</span><button type="button" class="btn-change-link" onclick="goToStep(0)">Change</button></div>
                <div class="summary-block-content"><strong id="sum-host-title">Apple MacBook</strong><span id="sum-host-meta">USB-C • 65W Required</span></div>
              </div>
              <div class="summary-block">
                <div class="summary-block-header"><span class="block-label">Power &amp; Connection Hub</span><button type="button" class="btn-change-link" onclick="goToStep(1)">Change</button></div>
                <div class="summary-block-content"><strong id="sum-dock-title">D2 Link 100 Dual-Screen Flagship Dock</strong><span id="sum-dock-meta">⚡ 100W PD • £120.00</span></div>
              </div>
              <div class="summary-block">
                <div class="summary-block-header"><span class="block-label">Display Screen</span><button type="button" class="btn-change-link" onclick="goToStep(2)">Change</button></div>
                <div class="summary-block-content"><strong id="sum-mon-title">M1 27-inch HDMI Productivity Monitor</strong><span id="sum-mon-meta">🖥️ 4K IPS • £145.00</span></div>
              </div>
            </div>

            <div class="setup-pricing-card">
              <h3 class="pricing-title">Bundle Investment</h3>
              <div class="pricing-line"><span>Hardware Subtotal</span><span id="wiz-subtotal-price">£265.00</span></div>
              <div class="pricing-line discount" id="wiz-discount-row"><span>🏷️ DESK10 (10% Off)</span><span id="wiz-discount-val">-£26.50</span></div>
              <div class="pricing-line"><span>Tracked UK Shipping</span><span id="wiz-shipping-val">FREE</span></div>
              <div class="pricing-divider"></div>
              <div class="pricing-total-row"><span>Total Setup</span><span class="total-gold" id="wiz-final-price">£238.50</span></div>

              <button type="button" class="btn-primary btn-checkout-bundle-cta" onclick="submitWizBundle()">
                <span>⚡ Add Complete Setup To Bag</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Sticky Controls Bottom Bar -->
      <div class="wizard-sticky-controls">
        <button type="button" class="btn-secondary btn-nav-back" id="wiz-btn-back" onclick="wizBackStep()">← Back</button>
        <button type="button" class="btn-primary btn-nav-next" id="wiz-btn-next" onclick="wizNextStep()">Next Step →</button>
      </div>
    </div>

    <!-- Right Side: Live CAD Blueprint Integration -->
    <aside class="wizard-blueprint-pane">
      <div class="blueprint-sticky-container">
        {% render 'nexa-workstation-blueprint' %}
      </div>
    </aside>
  </div>
</div>

{%- liquid
  assign all_prods = collections.all.products
  assign first_global_variant = all_prods.first.first_available_variant.id | default: all_prods.first.variants.first.id

  assign d1_item = all_prods | where: 'handle', 'd1-link-65' | first
  assign d2_item = all_prods | where: 'handle', 'd2-link-100-silver' | first
  if d2_item == blank
    assign d2_item = all_prods | where: 'handle', 'd2-link-100' | first
  endif
  assign d3_item = all_prods | where: 'handle', 'd3-pro-100' | first
  assign d4_item = all_prods | where: 'handle', 'd4-connect-a' | first

  assign m1_item = all_prods | where: 'handle', 'm1-27-inch-hdmi-productivity-monitor' | first
  if m1_item == blank
    assign m1_item = all_prods | where: 'handle', 'm1-studio-27' | first
  endif
  assign m2_item = all_prods | where: 'handle', 'm2-27-inch-displayport-monitor-high-refresh' | first
  if m2_item == blank
    assign m2_item = all_prods | where: 'handle', 'm2-view-32' | first
  endif
  assign m3_item = all_prods | where: 'handle', 'm3-27-inch-usb-c-monitor-hdmi-dp' | first
  if m3_item == blank
    assign m3_item = all_prods | where: 'handle', 'm3-dual-curved' | first
  endif

  assign s1_item = all_prods | where: 'handle', 's1-fixed-tilt-aluminium-laptop-stand' | first
  if s1_item == blank
    assign s1_item = all_prods | where: 'handle', 's1-fixed-tilt-laptop-stand' | first
  endif
  assign k1_item = all_prods | where: 'handle', 'k1-precision-mechanical-keyboard' | first
  if k1_item == blank
    assign k1_item = all_prods | where: 'handle', 'k1-precision-keyboard' | first
  endif
  assign m2acc_item = all_prods | where: 'handle', 'm-2-ergonomic-vertical-handshake-mouse' | first
  if m2acc_item == blank
    assign m2acc_item = all_prods | where: 'handle', 'm2-vertical-mouse' | first
  endif
-%}

<script>
  let wizStep = 0;
  let wizProfile = null;
  let wizDock = null;
  let wizMonitor = null;
  let wizAccessories = [];

  const WIZ_DATA = {
    profiles: {
      P1: { code: 'P1', label: 'Studio 65 (Windows)', connector: 'USB-C', watts: 65, os: ['Windows'] },
      P2: { code: 'P2', label: 'Studio 100 (Windows)', connector: 'USB-C', watts: 100, os: ['Windows'] },
      P3: { code: 'P3', label: 'Creator 65 (macOS)', connector: 'USB-C', watts: 65, os: ['macOS'] },
      P4: { code: 'P4', label: 'Classic A (Windows)', connector: 'USB-A', watts: 0, os: ['Windows'] }
    },
    docks: {
      d1: { id: 'd1', title: {{ d1_item.title | default: 'D1 Link 65 Standard Dock' | json }}, price: {{ d1_item.price | default: 9900 | divided_by: 100.0 }}, watts: 65, outputs: ['HDMI'], connector: 'USB-C', os: ['Windows', 'macOS'], variantId: {{ d1_item.first_available_variant.id | default: first_global_variant | default: 'null' }}, charging: '65W', videoOutputs: 'HDMI' },
      d2: { id: 'd2', title: {{ d2_item.title | default: 'D2 Link 100 Dual-Screen Flagship Dock' | json }}, price: {{ d2_item.price | default: 12000 | divided_by: 100.0 }}, watts: 100, outputs: ['HDMI', 'DisplayPort'], connector: 'USB-C', os: ['Windows', 'macOS'], variantId: {{ d2_item.first_available_variant.id | default: first_global_variant | default: 'null' }}, charging: '100W', videoOutputs: 'HDMI & DP' },
      d3: { id: 'd3', title: {{ d3_item.title | default: 'D3 Pro 100 High-Speed Workstation Dock' | json }}, price: {{ d3_item.price | default: 14900 | divided_by: 100.0 }}, watts: 100, outputs: ['DisplayPort'], connector: 'USB-C', os: ['Windows'], variantId: {{ d3_item.first_available_variant.id | default: first_global_variant | default: 'null' }}, charging: '100W', videoOutputs: 'DisplayPort' },
      d4: { id: 'd4', title: {{ d4_item.title | default: 'D4 Connect A Legacy Peripheral Hub' | json }}, price: {{ d4_item.price | default: 5900 | divided_by: 100.0 }}, watts: 0, outputs: [], connector: 'USB-A', os: ['Windows', 'macOS'], variantId: {{ d4_item.first_available_variant.id | default: first_global_variant | default: 'null' }}, charging: '0W', videoOutputs: 'None' }
    },
    monitors: {
      m1: { id: 'm1', title: {{ m1_item.title | default: 'M1 27-inch HDMI Productivity Monitor' | json }}, price: {{ m1_item.price | default: 14500 | divided_by: 100.0 }}, inputs: ['HDMI'], res: '4K IPS', variantId: {{ m1_item.first_available_variant.id | default: first_global_variant | default: 'null' }}, resolution: '4K IPS' },
      m2: { id: 'm2', title: {{ m2_item.title | default: 'M2 27-inch DisplayPort High-Refresh Monitor' | json }}, price: {{ m2_item.price | default: 18900 | divided_by: 100.0 }}, inputs: ['DisplayPort'], res: '4K 144Hz', variantId: {{ m2_item.first_available_variant.id | default: first_global_variant | default: 'null' }}, resolution: '4K 144Hz' },
      m3: { id: 'm3', title: {{ m3_item.title | default: 'M3 27-inch Universal Dual-Input Monitor' | json }}, price: {{ m3_item.price | default: 25000 | divided_by: 100.0 }}, inputs: ['HDMI', 'DisplayPort'], res: '5K Retina', variantId: {{ m3_item.first_available_variant.id | default: first_global_variant | default: 'null' }}, resolution: '5K Retina' }
    },
    accessories: {
      s1: { id: 's1', title: {{ s1_item.title | default: 'S1 Fixed Tilt Aluminium Laptop Stand' | json }}, price: {{ s1_item.price | default: 3500 | divided_by: 100.0 }}, role: 'stand', category: 'Laptop Stands', variantId: {{ s1_item.first_available_variant.id | default: first_global_variant | default: 'null' }} },
      k1: { id: 'k1', title: {{ k1_item.title | default: 'K1 Precision Mechanical Keyboard' | json }}, price: {{ k1_item.price | default: 6900 | divided_by: 100.0 }}, role: 'keyboard', category: 'Keyboards', variantId: {{ k1_item.first_available_variant.id | default: first_global_variant | default: 'null' }} },
      m2: { id: 'm2', title: {{ m2acc_item.title | default: 'M-2 Ergonomic Vertical Handshake Mouse' | json }}, price: {{ m2acc_item.price | default: 3900 | divided_by: 100.0 }}, role: 'mouse', category: 'Ergonomic Mice', variantId: {{ m2acc_item.first_available_variant.id | default: first_global_variant | default: 'null' }} }
    }
  };

  function goToStep(step) {
    wizStep = step;
    for (let i = 0; i <= 4; i++) {
      const pane = document.getElementById('wizard-pane-' + i);
      const nav = document.getElementById('step-nav-' + i);
      if (pane) pane.style.display = (i === step) ? 'block' : 'none';
      if (nav) {
        nav.classList.toggle('is-current', i === step);
        nav.classList.toggle('is-done', i < step);
      }
    }
    const backBtn = document.getElementById('wiz-btn-back');
    if (backBtn) backBtn.disabled = (step === 0);
    const nextBtn = document.getElementById('wiz-btn-next');
    if (nextBtn) {
      nextBtn.style.display = (step === 4) ? 'none' : 'inline-block';
    }
    updateWizTotals();
  }

  function wizBackStep() {
    if (wizStep > 0) goToStep(wizStep - 1);
  }

  function wizNextStep() {
    if (wizStep < 4) goToStep(wizStep + 1);
  }

  function wizSelectProfile(code) {
    wizProfile = WIZ_DATA.profiles[code];
    document.querySelectorAll('.setup-profile-card').forEach(c => c.classList.remove('is-selected'));
    const card = document.getElementById('wiz-card-' + code);
    if (card) card.classList.add('is-selected');

    // Update Blueprint
    const bpLabel = document.getElementById('bp-laptop-label');
    const bpMeta = document.getElementById('bp-laptop-meta');
    const bpConn = document.getElementById('bp-laptop-connector');
    if (bpLabel) bpLabel.textContent = wizProfile.label;
    if (bpMeta) bpMeta.textContent = `${wizProfile.connector} • ${wizProfile.watts}W Req`;
    if (bpConn) bpConn.textContent = wizProfile.connector;

    // Filter Docks
    validateDocksForProfile();
    goToStep(1);
  }

  function validateDocksForProfile() {
    if (!wizProfile) return;
    Object.keys(WIZ_DATA.docks).forEach(dId => {
      const d = WIZ_DATA.docks[dId];
      const card = document.getElementById('dock-card-' + dId);
      if (!card) return;
      const powerOk = d.watts >= wizProfile.watts;
      const connOk = d.connector === wizProfile.connector;
      const osOk = d.os.some(os => wizProfile.os.includes(os));
      const ok = powerOk && connOk && osOk;
      card.classList.toggle('is-incompatible', !ok);
    });
  }

  function wizSelectDock(dId) {
    const d = WIZ_DATA.docks[dId];
    if (wizProfile && (d.watts < wizProfile.watts || d.connector !== wizProfile.connector)) {
      alert(`Incompatible: Your ${wizProfile.label} demands ${wizProfile.watts}W charging on ${wizProfile.connector}. Please choose a compatible dock.`);
      return;
    }
    wizDock = d;
    document.querySelectorAll('.setup-dock-card').forEach(c => c.classList.remove('is-selected'));
    const card = document.getElementById('dock-card-' + dId);
    if (card) card.classList.add('is-selected');

    // Update Blueprint Dock
    const bpTitle = document.getElementById('bp-dock-title');
    const bpWatts = document.getElementById('bp-dock-watts');
    const bpCable1 = document.getElementById('bp-cable-laptop-dock');
    if (bpTitle) bpTitle.textContent = wizDock.title;
    if (bpWatts) bpWatts.textContent = `⚡ ${wizDock.watts}W PD`;
    if (bpCable1) bpCable1.style.display = 'block';

    goToStep(2);
  }

  function wizSelectMonitor(mId) {
    wizMonitor = WIZ_DATA.monitors[mId];
    document.querySelectorAll('.setup-monitor-card').forEach(c => c.classList.remove('is-selected'));
    const card = document.getElementById('mon-card-' + mId);
    if (card) card.classList.add('is-selected');

    // Update Blueprint Monitor
    const bpTitle = document.getElementById('bp-monitor-title');
    const bpRes = document.getElementById('bp-monitor-res');
    const bpCable2 = document.getElementById('bp-cable-dock-monitor');
    if (bpTitle) bpTitle.textContent = wizMonitor.title;
    if (bpRes) bpRes.textContent = wizMonitor.res;
    if (bpCable2) bpCable2.style.display = 'block';

    goToStep(3);
  }

  function wizToggleAccessory(accId) {
    const idx = wizAccessories.indexOf(accId);
    const card = document.getElementById('acc-card-' + accId);
    if (idx > -1) {
      wizAccessories.splice(idx, 1);
      if (card) {
        card.classList.remove('is-added');
        card.querySelector('.btn-toggle-accessory').textContent = '+ Add to Setup';
      }
    } else {
      wizAccessories.push(accId);
      if (card) {
        card.classList.add('is-added');
        card.querySelector('.btn-toggle-accessory').textContent = '✓ Added to Setup';
      }
    }
  }

  function updateWizTotals() {
    // Dynamically update Step 4 Review Component Cards
    const hostTitle = document.getElementById('sum-host-title');
    const hostMeta = document.getElementById('sum-host-meta');
    if (hostTitle && wizProfile) hostTitle.textContent = wizProfile.label;
    if (hostMeta && wizProfile) hostMeta.textContent = `${wizProfile.connector} • ${wizProfile.watts}W Required`;

    const dockTitle = document.getElementById('sum-dock-title');
    const dockMeta = document.getElementById('sum-dock-meta');
    if (dockTitle) dockTitle.textContent = wizDock ? wizDock.title : 'No Dock Selected';
    if (dockMeta) dockMeta.textContent = wizDock ? `⚡ ${wizDock.watts}W PD • £${(wizDock.price || 0).toFixed(2)}` : 'Select a dock in Step 2';

    const monTitle = document.getElementById('sum-mon-title');
    const monMeta = document.getElementById('sum-mon-meta');
    if (monTitle) monTitle.textContent = wizMonitor ? wizMonitor.title : 'No Monitor Selected';
    if (monMeta) monMeta.textContent = wizMonitor ? `🖥️ ${wizMonitor.res || '4K Screen'} • £${(wizMonitor.price || 0).toFixed(2)}` : 'Select a screen in Step 3';

    // Update Accessories in Review Step
    let accSummaryBlock = document.getElementById('sum-acc-block');
    const summaryBreakdown = document.querySelector('.setup-summary-breakdown');
    if (wizAccessories.length > 0) {
      if (!accSummaryBlock && summaryBreakdown) {
        accSummaryBlock = document.createElement('div');
        accSummaryBlock.className = 'summary-block';
        accSummaryBlock.id = 'sum-acc-block';
        summaryBreakdown.appendChild(accSummaryBlock);
      }
      if (accSummaryBlock) {
        const accListHtml = wizAccessories.map(id => {
          const item = WIZ_DATA.accessories[id];
          return `<li><span>${item ? item.title : id}</span><strong>£${item ? item.price.toFixed(2) : '0.00'}</strong></li>`;
        }).join('');
        accSummaryBlock.innerHTML = `
          <div class="summary-block-header">
            <span class="block-label">Ergonomic Peripherals (${wizAccessories.length})</span>
            <button type="button" class="btn-change-link" onclick="goToStep(3)">Change</button>
          </div>
          <div class="summary-block-content">
            <ul class="summary-acc-list">${accListHtml}</ul>
          </div>
        `;
      }
    } else if (accSummaryBlock) {
      accSummaryBlock.remove();
    }

    let subtotal = (wizDock?.price || 0) + (wizMonitor?.price || 0);
    wizAccessories.forEach(id => {
      subtotal += WIZ_DATA.accessories[id]?.price || 0;
    });

    const qualifiesDesk10 = subtotal >= 200;
    const discount = qualifiesDesk10 ? subtotal * 0.1 : 0;
    const postDiscount = subtotal - discount;
    const freeShipping = postDiscount >= 300;

    const elSub = document.getElementById('wiz-subtotal-price');
    const elDiscRow = document.getElementById('wiz-discount-row');
    const elDisc = document.getElementById('wiz-discount-val');
    const elShip = document.getElementById('wiz-shipping-val');
    const elTotal = document.getElementById('wiz-final-price');

    if (elSub) elSub.textContent = '£' + subtotal.toFixed(2);
    if (elDiscRow) elDiscRow.style.display = qualifiesDesk10 ? 'flex' : 'none';
    if (elDisc) elDisc.textContent = '-£' + discount.toFixed(2);
    if (elShip) {
      elShip.textContent = freeShipping ? 'FREE' : '£7.95';
      elShip.className = freeShipping ? 'total-gold' : '';
    }
    if (elTotal) elTotal.textContent = '£' + (freeShipping ? postDiscount : postDiscount + 7.95).toFixed(2);
  }

  function submitWizBundle() {
    const bundlePayload = {
      profile: wizProfile || WIZ_DATA.profiles['P3'],
      dock: wizDock || WIZ_DATA.docks['d2'],
      monitor: wizMonitor || WIZ_DATA.monitors['m1'],
      accessories: wizAccessories.map(id => WIZ_DATA.accessories[id]).filter(Boolean)
    };

    // If single-click Bundle Drawer exists on page, invoke it seamlessly
    if (typeof openBundleDrawer === 'function') {
      openBundleDrawer(bundlePayload);
      return;
    }

    // Direct Cart submission fallback with line item properties
    const bundleRef = 'SETUP-' + Date.now().toString(36).toUpperCase();
    const items = [];

    if (bundlePayload.dock?.variantId) {
      items.push({
        id: bundlePayload.dock.variantId,
        quantity: 1,
        properties: {
          '_SetupReference': bundleRef,
          '_DeviceProfile': bundlePayload.profile?.label || 'Workstation',
          'Workstation Role': 'Docking Station Hub'
        }
      });
    }

    if (bundlePayload.monitor?.variantId) {
      items.push({
        id: bundlePayload.monitor.variantId,
        quantity: 1,
        properties: {
          '_SetupReference': bundleRef,
          '_DeviceProfile': bundlePayload.profile?.label || 'Workstation',
          'Workstation Role': 'Display Monitor'
        }
      });
    }

    bundlePayload.accessories.forEach(acc => {
      if (acc?.variantId) {
        items.push({
          id: acc.variantId,
          quantity: 1,
          properties: {
            '_SetupReference': bundleRef,
            '_DeviceProfile': bundlePayload.profile?.label || 'Workstation',
            'Workstation Role': acc.title
          }
        });
      }
    });

    if (items.length > 0) {
      const btn = document.querySelector('.btn-checkout-bundle-cta');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span>⏳ Adding Workstation to Cart...</span>';
      }

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: items })
      }).then(res => {
        if (res.ok) {
          if (btn) btn.innerHTML = '<span>✓ Complete Setup Added!</span>';
          if (window.NexaCart && typeof window.NexaCart.open === 'function') {
            window.NexaCart.open();
            window.dispatchEvent(new CustomEvent('cart:updated'));
          } else {
            const drawer = document.querySelector('cart-drawer');
            if (drawer && typeof drawer.open === 'function') drawer.open();
            else window.location.href = '/cart';
          }
        } else {
          window.location.href = '/cart';
        }
      }).catch(err => {
        console.error(err);
        window.location.href = '/cart';
      });
    } else {
      window.location.href = '/collections/all';
    }
  }

  // Pre-select based on URL params (?check=d1-link-65, ?profile=P1) or default to P3
  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const profileParam = urlParams.get('profile');
    const checkParam = urlParams.get('check');

    if (profileParam && WIZ_DATA.profiles[profileParam]) {
      wizSelectProfile(profileParam);
    } else {
      wizSelectProfile('P3');
    }

    if (checkParam) {
      if (checkParam.includes('d1')) wizSelectDock('d1');
      else if (checkParam.includes('d2')) wizSelectDock('d2');
      else if (checkParam.includes('d3')) wizSelectDock('d3');
      else if (checkParam.includes('d4')) wizSelectDock('d4');
      else if (!wizDock) wizDock = WIZ_DATA.docks['d2'];

      // Move to Step 2 to verify compatibility
      goToStep(1);
    } else {
      if (!wizDock) wizDock = WIZ_DATA.docks['d2'];
    }

    if (!wizMonitor) wizMonitor = WIZ_DATA.monitors['m1'];
    updateWizTotals();
  });
</script>

