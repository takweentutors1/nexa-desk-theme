{%- if request.path contains '/blogs/' or request.path contains '/journal' -%}
  {% section 'nexa-journal-page' %}
{%- elsif request.path == '/pages/compare' or request.path == '/pages/compare-docks' -%}
  {% section 'nexa-spec-diff-toggle' %}
{%- elsif request.path == '/pages/setup-builder' or request.path == '/pages/find-my-setup' -%}
  {% section 'nexa-setup-wizard' %}
  {% section 'nexa-bundle-drawer' %}
{%- elsif request.path == '/pages/compatibility-faq' -%}
  {% section 'nexa-compatibility-faq-page' %}
{%- elsif request.path == '/pages/about' -%}
  {% section 'nexa-about-page' %}
{%- elsif request.path contains '/policies/' -%}
  {% section 'nexa-policy-page' %}
{%- elsif request.path contains '/search' -%}
  {% section 'nexa-search-page' %}
{%- else -%}
<div class="nexa-404-container" style="min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 4rem 1.5rem; text-align: center;">
  <div class="nexa-404-card" style="max-width: 640px; width: 100%; background: rgba(14, 21, 38, 0.8); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 20px; padding: 3.5rem 2.5rem; backdrop-filter: blur(16px); box-shadow: 0 20px 50px rgba(0,0,0,0.5);">
    <div style="font-size: 4rem; font-weight: 800; background: linear-gradient(135deg, #d4af37, #38bdf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; line-height: 1; margin-bottom: 1rem;">
      404
    </div>
    <h1 style="font-size: 1.85rem; font-weight: 700; color: #ffffff; margin-bottom: 0.75rem;">
      Page Not Found
    </h1>
    <p style="color: #94a3b8; font-size: 1.05rem; line-height: 1.6; margin-bottom: 2rem;">
      The workstation page you're searching for might have moved or is under recalibration.
    </p>

    <div style="display: flex; flex-direction: column; sm-flex-direction: row; gap: 0.85rem; justify-content: center;">
      <a href="/pages/find-my-setup" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.85rem 1.5rem; background: linear-gradient(135deg, #d4af37, #f59e0b); color: #030712; font-weight: 700; font-size: 0.95rem; border-radius: 10px; text-decoration: none; transition: transform 0.2s;">
        <span>🎯 Find My Laptop Setup</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
      <a href="/pages/compare-docks" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.85rem 1.5rem; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; font-weight: 600; font-size: 0.95rem; border-radius: 10px; text-decoration: none;">
        <span>⚖️ Compare Docks</span>
      </a>
      <a href="/collections/all" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.85rem 1.5rem; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #e2e8f0; font-weight: 600; font-size: 0.95rem; border-radius: 10px; text-decoration: none;">
        <span>Browse All Gear</span>
      </a>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
