<section class="bento-collections-section page-width" data-section-id="{{ section.id }}" aria-label="Curated Workspace Collections">
  <div class="bento-header">
    <div class="bento-header-pill">
      <span class="bento-sparkle" aria-hidden="true"></span>
      <span class="bento-badge-text">Tested &amp; Guaranteed for Everyday Work</span>
    </div>

    <h2 class="bento-title">
      Pick what you need to upgrade your desk.
    </h2>

    <p class="bento-subtitle">
      From single-cable docks to neck-saving stands, all our gear is hand-picked to make working from home comfortable, quiet, and clutter-free.
    </p>
  </div>

  <div class="bento-grid">
    <!-- Card 1: One-Cable Docks & Hubs (Span 2) -->
    <div class="bento-card-wrapper span-2-lg">
      <a href="{{ routes.all_products_collection_url }}" class="bento-card bento-gradient-blue nexa-card">
        <div class="bento-card-content">
          <div class="bento-badge-row">
            <span class="bento-pill badge-gold">Customer Favorite</span>
            <span class="bento-tagline">Clean &amp; Tidy Desk</span>
          </div>
          <h3 class="bento-card-title">One-Cable Docks &amp; Hubs</h3>
          <p class="bento-card-desc">
            Plug one cord into your laptop. Your battery charges, big screens turn on, and your keyboard and mouse connect instantly.
          </p>
        </div>

        <div class="bento-chips-row">
          <span class="bento-chip">
            <svg width="13" height="13" viewBox="0 0 170 170" fill="currentColor"><path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.69-3.04-7.69-7.85-12-14.42-6.2-9.35-11.05-19.8-14.56-31.35-3.51-11.55-5.27-22.37-5.27-32.48 0-14.13 3.63-25.75 10.88-34.86 7.25-9.11 16.48-13.84 27.69-14.19 4.35 0 9.28 1.16 14.78 3.49 5.51 2.32 9.49 3.55 11.96 3.69 2.22 0 6.54-1.37 12.96-4.12 6.42-2.75 11.96-3.91 16.61-3.49 12.52.95 22.42 5.63 29.69 14.04-10.97 6.64-16.35 15.68-16.14 27.12.21 9.07 3.73 16.66 10.56 22.77 6.83 6.11 14.72 9.69 23.68 10.74-2.22 6.96-5.01 14.03-8.36 21.23zM119.22 31.84c0-7.39 2.68-14.28 8.04-20.67 5.36-6.39 12.01-10.45 19.95-12.17.21 1.06.32 2.01.32 2.85 0 7.39-2.82 14.39-8.46 21-5.63 6.6-12.35 10.45-20.16 11.55-.1-1.05-.15-2.02-.15-2.91l.46.35z"/></svg>
            Apple Mac &amp; MacBook
          </span>
          <span class="bento-chip">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.8"/></svg>
            Windows Laptops
          </span>
          <span class="bento-chip">Fast Charging</span>
          <span class="bento-chip">2 Big Screens</span>
        </div>

        
        <div class="bento-illustration-container">
          <div class="bento-visual-dock">
            <div class="bento-dock-box">
              <span class="dock-light-glow"></span>
              <div class="dock-port-strip">
                <span class="mini-port usb-c"></span>
                <span class="mini-port usb-a"></span>
                <span class="mini-port aux"></span>
              </div>
            </div>
          </div>
        </div>
        
        <div class="bento-illustration-container">
          <div class="bento-visual-monitor">
            <div class="mini-monitor-frame">
              <div class="mini-monitor-screen">
                <div class="mini-bar top"></div>
                <div class="mini-card-grid">
                  <div class="mini-card"></div>
                  <div class="mini-card"></div>
                </div>
              </div>
            </div>
            <div class="mini-monitor-stand"></div>
          </div>
        </div>
        <div class="bento-action-footer">
          <span class="bento-cta-text">See Verified Docks <span class="bento-arrow-icon">&rarr;</span></span>
        </div>
      </a>
    </div>

    <!-- Card 2: Extra Wide Desk Screens (Span 2) -->
    <div class="bento-card-wrapper span-2-lg">
      <a href="{{ routes.all_products_collection_url }}" class="bento-card bento-gradient-indigo nexa-card">
        <div class="bento-card-content">
          <div class="bento-badge-row">
            <span class="bento-pill badge-cyan">Easy on Eyes</span>
            <span class="bento-tagline">Comfortable on Your Eyes</span>
          </div>
          <h3 class="bento-card-title">Extra Wide Desk Screens</h3>
          <p class="bento-card-desc">
            Big, clear screens with plenty of room for emails, video calls, and work. No small text or squinting required.
          </p>
        </div>

        <div class="bento-chips-row">
          <span class="bento-chip">Works with Mac</span>
          <span class="bento-chip">Works with Windows</span>
          <span class="bento-chip">Zero Screen Glare</span>
          <span class="bento-chip">Super Sharp &amp; Clear</span>
        </div>

        
        <div class="bento-illustration-container">
          <div class="bento-visual-monitor">
            <div class="mini-monitor-frame">
              <div class="mini-monitor-screen">
                <div class="mini-bar top"></div>
                <div class="mini-card-grid">
                  <div class="mini-card"></div>
                  <div class="mini-card"></div>
                </div>
              </div>
            </div>
            <div class="mini-monitor-stand"></div>
          </div>
        </div>
        
        <div class="bento-illustration-container">
          <div class="mini-stand-frame">
            <div class="mini-stand-laptop-holder"></div>
            <div class="mini-stand-base"></div>
          </div>
        </div>
        <div class="bento-action-footer">
          <span class="bento-cta-text">Explore Computer Screens <span class="bento-arrow-icon">&rarr;</span></span>
        </div>
      </a>
    </div>

    <!-- Card 3: Adjustable Laptop Stands (Span 1) -->
    <div class="bento-card-wrapper span-1-lg">
      <a href="{{ routes.all_products_collection_url }}" class="bento-card bento-gradient-emerald nexa-card">
        <div class="bento-card-content">
          <div class="bento-badge-row">
            <span class="bento-pill badge-emerald">Stops Neck Pain</span>
            <span class="bento-tagline">Healthy Posture</span>
          </div>
          <h3 class="bento-card-title">Adjustable Laptop Stands</h3>
          <p class="bento-card-desc">
            Lifts your screen to eye level so you do not have to hunch over or strain your neck and back.
          </p>
        </div>

        <div class="bento-chips-row">
          <span class="bento-chip">Eye Level Height</span>
          <span class="bento-chip">Strong Aluminum</span>
        </div>

        
        <div class="bento-illustration-container">
          <div class="mini-stand-frame">
            <div class="mini-stand-laptop-holder"></div>
            <div class="mini-stand-base"></div>
          </div>
        </div>
        
        <div class="bento-illustration-container">
          <div class="mini-mouse-body">
            <div class="mini-mouse-wheel"></div>
          </div>
        </div>
        <div class="bento-action-footer">
          <span class="bento-cta-text">See Stands <span class="bento-arrow-icon">&rarr;</span></span>
        </div>
      </a>
    </div>

    <!-- Card 4: Comfortable Wireless Mice (Span 1) -->
    <div class="bento-card-wrapper span-1-lg">
      <a href="{{ routes.all_products_collection_url }}" class="bento-card bento-gradient-purple nexa-card">
        <div class="bento-card-content">
          <div class="bento-badge-row">
            <span class="bento-pill badge-purple">No Wrist Ache</span>
            <span class="bento-tagline">Easy on Your Hands</span>
          </div>
          <h3 class="bento-card-title">Comfortable Wireless Mice</h3>
          <p class="bento-card-desc">
            Smooth, natural palm support designed so your wrist feels relaxed even after an entire day of working.
          </p>
        </div>

        <div class="bento-chips-row">
          <span class="bento-chip">Whisper-Quiet Click</span>
          <span class="bento-chip">Works Cord-Free</span>
        </div>

        
        <div class="bento-illustration-container">
          <div class="mini-mouse-body">
            <div class="mini-mouse-wheel"></div>
          </div>
        </div>
        <div class="bento-action-footer">
          <span class="bento-cta-text">See Mice <span class="bento-arrow-icon">&rarr;</span></span>
        </div>
      </a>
    </div>

    <!-- Card 5: Quiet & Comfortable Keyboards (Span 2) -->
    <div class="bento-card-wrapper span-2-lg">
      <a href="{{ routes.all_products_collection_url }}" class="bento-card bento-gradient-amber nexa-card">
        <div class="bento-card-content">
          <div class="bento-badge-row">
            <span class="bento-pill badge-amber">Quiet &amp; Smooth</span>
            <span class="bento-tagline">Effortless Daily Typing</span>
          </div>
          <h3 class="bento-card-title">Quiet &amp; Comfortable Keyboards</h3>
          <p class="bento-card-desc">
            Gentle, soft keys that let you type fast without noisy click-clack sounds or tired fingers.
          </p>
        </div>

        <div class="bento-chips-row">
          <span class="bento-chip">Mac Keyboard Layout</span>
          <span class="bento-chip">Windows Keys</span>
          <span class="bento-chip">Months of Battery</span>
        </div>

        
        <div class="bento-illustration-container">
          <div class="mini-keyboard-plate">
            <div class="mini-key-row">
              <span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="mini-key-row">
              <span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="mini-key-row space">
              <span class="spacebar"></span>
            </div>
          </div>
        </div>
        <div class="bento-action-footer">
          <span class="bento-cta-text">See Keyboards <span class="bento-arrow-icon">&rarr;</span></span>
        </div>
      </a>
    </div>
  </div>
</section>

