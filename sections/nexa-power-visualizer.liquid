<section class="power-flow-section" data-section-id="{{ section.id }}" aria-label="How One Cable Replaces All Messy Chargers">
  <div class="power-flow-container">
    <!-- Section Header in Everyday Plain Language -->
    <div class="power-flow-header">
      <div class="flow-badge-pill">
        <span class="flow-sparkle-dot" aria-hidden="true"></span>
        <span class="flow-badge-text">No More Cable Clutter</span>
      </div>

      <h2 class="flow-title">
        One single wire does the work of 5 messy chargers.
      </h2>

      <p class="flow-subtitle">
        Plug in just one cord when you sit down. Your laptop battery charges at full speed, your two large desk screens turn on immediately, and your mouse and keyboard connect with zero fuss.
      </p>

      <!-- Stream Selector Buttons with Human-Friendly Terms -->
      <div class="flow-toggle-group" role="tablist" aria-label="Choose what you want to see inside the wire">
        <button
          type="button"
          role="tab"
          id="flow-tab-all"
          class="flow-tab-btn is-active"
          onclick="setFlowStream('all')"
        >
          <span class="tab-dot all" aria-hidden="true"></span>
          <span>Show Everything (Charging + 2 Screens + Mouse)</span>
        </button>

        <button
          type="button"
          role="tab"
          id="flow-tab-power"
          class="flow-tab-btn"
          onclick="setFlowStream('power')"
        >
          <span class="tab-dot power" aria-hidden="true"></span>
          <span>Fast Laptop Charging</span>
        </button>

        <button
          type="button"
          role="tab"
          id="flow-tab-video"
          class="flow-tab-btn"
          onclick="setFlowStream('video')"
        >
          <span class="tab-dot video" aria-hidden="true"></span>
          <span>Two Big Extra Screens</span>
        </button>
      </div>
    </div>

    <!-- Visual Interactive Canvas -->
    <div class="flow-canvas-wrapper">
      <!-- Top Live Stats Bar - Plain English -->
      <div class="flow-canvas-stats">
        <div class="flow-stat-chip active-power" id="flow-stat-power">
          <span class="stat-indicator yellow-dot"></span>
          <div class="stat-copy">
            <strong>Rapid Battery Charging</strong>
            <span>Keeps laptop 100% full without heavy chargers</span>
          </div>
        </div>

        <div class="flow-stat-chip active-video" id="flow-stat-video">
          <span class="stat-indicator blue-dot"></span>
          <div class="stat-copy">
            <strong>Two Big Crisp Monitors</strong>
            <span>Clear text that is comfortable and easy on eyes</span>
          </div>
        </div>

        <div class="flow-stat-chip active-data" id="flow-stat-data">
          <span class="stat-indicator green-dot"></span>
          <div class="stat-copy">
            <strong>Mouse, Keyboard &amp; Sound</strong>
            <span>All your desktop gear connects instantly</span>
          </div>
        </div>
      </div>

      <!-- SVG Animated Current Stage -->
      <div class="flow-stage-interactive">
        <!-- Left Source: The Desk Hub -->
        <div class="flow-endpoint dock-endpoint">
          <div class="endpoint-icon-box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="6" width="20" height="12" rx="3"></rect>
              <line x1="6" y1="12" x2="6.01" y2="12" stroke-width="3"></line>
              <line x1="10" y1="12" x2="10.01" y2="12" stroke-width="3"></line>
              <line x1="14" y1="12" x2="14.01" y2="12" stroke-width="3"></line>
              <line x1="18" y1="12" x2="18.01" y2="12" stroke-width="3"></line>
              <path d="M7 18v2M17 18v2"></path>
            </svg>
          </div>
          <strong class="endpoint-name">Nexa Desk Hub</strong>
          <span class="endpoint-sub">Plugs into wall outlet</span>
          <span class="endpoint-tag">Powers Entire Desk</span>
        </div>

        <!-- Central Cable Stream SVG with Glowing animated paths -->
        <div class="flow-cable-svg-box">
          <svg class="flow-svg-canvas" viewBox="0 0 540 180" fill="none">
            <!-- Background Outer Shielding Cord -->
            <path
              d="M 20 90 C 140 30, 400 150, 520 90"
              stroke="rgba(255, 255, 255, 0.08)"
              stroke-width="28"
              stroke-linecap="round"
            ></path>

            <!-- 1. POWER STREAM PATH -->
            <path
              id="svg-path-power-glow"
              d="M 20 78 C 140 18, 400 138, 520 78"
              stroke="rgba(245, 158, 11, 0.25)"
              stroke-width="10"
              stroke-linecap="round"
            ></path>
            <path
              id="svg-path-power-core"
              d="M 20 78 C 140 18, 400 138, 520 78"
              stroke="#f59e0b"
              stroke-width="4"
              stroke-linecap="round"
              class="flowing-current-path power"
            ></path>

            <!-- 2. DUAL VIDEO SCREEN STREAM -->
            <path
              id="svg-path-video-glow"
              d="M 20 90 C 140 30, 400 150, 520 90"
              stroke="rgba(56, 189, 248, 0.25)"
              stroke-width="10"
              stroke-linecap="round"
            ></path>
            <path
              id="svg-path-video-core"
              d="M 20 90 C 140 30, 400 150, 520 90"
              stroke="#38bdf8"
              stroke-width="4"
              stroke-linecap="round"
              class="flowing-current-path video"
            ></path>

            <!-- 3. ACCESSORY DATA STREAM -->
            <path
              id="svg-path-data-glow"
              d="M 20 102 C 140 42, 400 162, 520 102"
              stroke="rgba(34, 197, 94, 0.25)"
              stroke-width="10"
              stroke-linecap="round"
            ></path>
            <path
              id="svg-path-data-core"
              d="M 20 102 C 140 42, 400 162, 520 102"
              stroke="#22c55e"
              stroke-width="3.5"
              stroke-linecap="round"
              class="flowing-current-path data"
            ></path>
          </svg>

          <!-- In-Transit Label Badge -->
          <div class="flow-center-tag">
            <span class="cable-type-pill">⚡ Strong Braided Cable (Included)</span>
          </div>
        </div>

        <!-- Right Destination: Your Apple MacBook or Windows Laptop -->
        <div class="flow-endpoint laptop-endpoint">
          <div class="endpoint-icon-box laptop" style="display:flex; gap:0.45rem; align-items:center; justify-content:center;">
            <svg width="22" height="22" viewBox="0 0 170 170" fill="currentColor">
              <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.69-3.04-7.69-7.85-12-14.42-6.2-9.35-11.05-19.8-14.56-31.35-3.51-11.55-5.27-22.37-5.27-32.48 0-14.13 3.63-25.75 10.88-34.86 7.25-9.11 16.48-13.84 27.69-14.19 4.35 0 9.28 1.16 14.78 3.49 5.51 2.32 9.49 3.55 11.96 3.69 2.22 0 6.54-1.37 12.96-4.12 6.42-2.75 11.96-3.91 16.61-3.49 12.52.95 22.42 5.63 29.69 14.04-10.97 6.64-16.35 15.68-16.14 27.12.21 9.07 3.73 16.66 10.56 22.77 6.83 6.11 14.72 9.69 23.68 10.74-2.22 6.96-5.01 14.03-8.36 21.23zM119.22 31.84c0-7.39 2.68-14.28 8.04-20.67 5.36-6.39 12.01-10.45 19.95-12.17.21 1.06.32 2.01.32 2.85 0 7.39-2.82 14.39-8.46 21-5.63 6.6-12.35 10.45-20.16 11.55-.1-1.05-.15-2.02-.15-2.91l.46.35z"/>
            </svg>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.8"/>
            </svg>
          </div>
          <strong class="endpoint-name">Your Laptop</strong>
          <span class="endpoint-sub">Apple MacBook or Windows PC</span>
          <span class="endpoint-tag success">Works 100% Guaranteed</span>
        </div>
      </div>

      <!-- Three Feature Cards Below -->
      <div class="flow-feature-cards-grid">
        <div class="flow-card">
          <div class="flow-card-icon power-bg">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <h3 class="flow-card-title">Leave Your Bulky Charger at Home</h3>
          <p class="flow-card-desc">
            The hub stays plugged into the wall and delivers fast, safe power straight into your laptop. You will never have to hunt for an outlet or pack heavy bricks in your bag.
          </p>
        </div>

        <div class="flow-card">
          <div class="flow-card-icon video-bg">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.5">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h3 class="flow-card-title">Two Big Screens Without Any Lag</h3>
          <p class="flow-card-desc">
            Spread your emails, spreadsheets, and video calls across two large monitors. Everything stays crystal clear with no flickering or sluggish delay.
          </p>
        </div>

        <div class="flow-card">
          <div class="flow-card-icon data-bg">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="flow-card-title">Sit Down &amp; Start Working in 2 Seconds</h3>
          <p class="flow-card-desc">
            Just plug in one cable when you sit down. Your mouse, keyboard, speakers, and wired internet instantly wake up ready to go.
          </p>
        </div>
      </div>

      <!-- Bottom Action Strip -->
      <div class="flow-bottom-action">
        <div class="action-text">
          <strong>Ready to clean up your workspace?</strong>
          <span>Take our quick 30-second quiz to find the perfect one-cable dock for your exact laptop.</span>
        </div>
        <a href="/pages/find-my-setup" class="flow-action-btn">
          <span>Find My One-Cable Dock</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  function setFlowStream(stream) {
    document.querySelectorAll('.flow-tab-btn').forEach(btn => btn.classList.remove('is-active'));
    const activeBtn = document.getElementById('flow-tab-' + stream);
    if (activeBtn) activeBtn.classList.add('is-active');

    // Controls visibility of SVG paths
    const showPower = (stream === 'all' || stream === 'power');
    const showVideo = (stream === 'all' || stream === 'video');
    const showData = (stream === 'all');

    ['svg-path-power-glow', 'svg-path-power-core'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.display = showPower ? 'block' : 'none';
    });

    ['svg-path-video-glow', 'svg-path-video-core'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.display = showVideo ? 'block' : 'none';
    });

    ['svg-path-data-glow', 'svg-path-data-core'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.display = showData ? 'block' : 'none';
    });

    // Control visibility / styles of top chips
    const statPower = document.getElementById('flow-stat-power');
    const statVideo = document.getElementById('flow-stat-video');
    const statData = document.getElementById('flow-stat-data');

    if (statPower) statPower.style.opacity = showPower ? '1' : '0.35';
    if (statVideo) statVideo.style.opacity = showVideo ? '1' : '0.35';
    if (statData) statData.style.opacity = showData ? '1' : '0.35';
  }
</script>

{% schema %}
{
  "name": "Nexa Power Flow",
  "settings": [],
  "presets": [
    {
      "name": "Nexa Power Flow Visualizer"
    }
  ]
}
{% endschema %}
